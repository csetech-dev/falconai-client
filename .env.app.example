# ===============
# FalconAI — Application stack environment
# Used by: make deploy-app
# Copy to .env.app, set storage host/IP, then deploy on any host.
# ==================

COMPOSE_PROJECT_NAME=falcon-app

# ------------
# Hardware sizing profile for THIS host: test | prod
#   test — 32 GB RAM / 6 cores (12 threads).  ~39 GB of container limits.
#   prod — 495 GB RAM / 124 cores.            ~424 GB of container limits.
# Loads .env.sizing.<profile>, which sets every container limit, shm_size and
# concurrency knob. Those files are vendor-managed and replaced on update —
# to change a single knob, set it further down in THIS file instead; values
# here are layered after the profile and win.
# ------------
FALCON_SIZING_PROFILE=test

# Enable all social/news scrapers (worker-fb, worker-linkedin, worker-news×8, worker-x, …).
# Add `split` (COMPOSE_PROFILES=scrapers,split) to run core as two containers —
# see "Core: API / automation split" below.
COMPOSE_PROFILES=scrapers

# ------------
# Core: API / automation split
# -------------
# core can run as ONE container doing everything (the default, and what every
# deployment did before this existed) or as TWO:
#
#   falcon-core             SERVICE_ROLE=api        dashboard HTTP + SSE only
#   falcon-core-automation  SERVICE_ROLE=automation schedulers, BullMQ consumers,
#                                                   AI loops, machine ingest
#
# Why: core is Node, so it is ONE event loop. It was running ~20 scheduler
# timers, 9 queue consumers (the Facebook one at concurrency 24) and three AI
# automation loops on the same loop that answered the dashboard — a scrape batch
# and the UI were competing for the same thread, which is why pages hung while
# an API call was "pending". Two processes is the only thing that separates them;
# more CPU quota on one container cannot.
#
# The four settings below MOVE TOGETHER. Enabling one without the others either
# does nothing or silently stops all background work:
#
#   COMPOSE_PROFILES=scrapers,split                     start the second container
#   CORE_SERVICE_ROLE=api                               stop falcon-core running automation
#   CORE_INTERNAL_URL=http://falcon-core-automation:4000 workers call the automation plane
#   CORE_AUTOMATION_ENDPOINT=falcon-core-automation:4000 gateway routes machine paths there
#
# Also copy the FALCON_SZ_CORE_SPLIT_* / CORE_SPLIT_* values from your
# .env.sizing.<profile> file into this file under their non-SPLIT names, so the
# api plane hands its old memory and connection budget to the automation plane
# rather than both claiming the full amount.
#
# To verify after deploying, and to catch the dangerous half-configuration
# (role=api with no automation container — everything answers 200 while nothing
# runs in the background):
#   curl localhost:12010/api/v1/health   -> role=api,        automation.planeSeen=true
#   curl localhost:12011/api/v1/health   -> role=automation, schedulers/processors > 0
#
# To roll back: unset all four, restart. No schema or data change is involved.
#CORE_SERVICE_ROLE=api
#CORE_INTERNAL_URL=http://falcon-core-automation:4000
#CORE_AUTOMATION_ENDPOINT=falcon-core-automation:4000

# ------------
# Hosts — set once; deploy scripts derive all URLs below
# -------------
# WireGuard tunnel toggle (must match the storage host's setting).
#   true  (default): encrypt app<->storage. Set STORAGE_SERVER_IP below to THIS
#          app host's OWN LAN IP (the local falcon-wg-app sidecar republishes the
#          storage ports here). The storage host's public IP goes in
#          infra/wireguard/app/wg0.conf (Endpoint).
#   false: connect directly in PLAINTEXT. Set STORAGE_SERVER_IP to the STORAGE
#          host's IP (no tunnel, no wg0.conf needed).
# See docs/WIREGUARD_STORAGE_TUNNEL.md.
WIREGUARD_ENABLED=true

# Tunnel ON  -> this app host's OWN LAN IP.   Tunnel OFF -> the storage host's IP.
STORAGE_SERVER_IP=10.0.0.6

# WireGuard tunnel port (must match WG_LISTEN_PORT in .env.storage).
WG_LISTEN_PORT=51820

# App machine (gateway, frontend, Keycloak browser URLs).
# Defaults to STORAGE_SERVER_IP when unset (single-host deploy).
APP_HOST=10.0.0.6

# Public browser URL when a reverse proxy terminates TLS.
PUBLIC_APP_URL=https://app2.csetech.diu.edu.bd

# Cloudflare Tunnel: cloudflared runs as a HOST service (systemd), not a
# container in this stack — same arrangement as the GHCR deploy webhook.
# Point the tunnel's public hostname at  http://localhost:12006  (the
# api-gateway port), NOT :12001. The gateway serves both the SPA and /api/*,
# and the frontend calls those same-origin, so a tunnel aimed at :12001 gives
# a working UI whose every API call 404s.
# Because cloudflared is on the host, api-gateway's 12006 port mapping must
# stay published — do not remove it from docker-compose.app.yml.

# server = Falcon login page; falcon-auth validates with Keycloak privately (recommended).
# browser = redirect users to Keycloak (only if you need cross-app SSO).
OIDC_LOGIN_MODE=server

# Browser-only (OIDC_LOGIN_MODE=browser): public Keycloak path under the app URL.
# KEYCLOAK_PUBLIC_URL=https://app2.csetech.diu.edu.bd/api/keycloak

POSTGRES_PORT=12002
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass998!

# MinIO ports — must match .env.storage. Used by the WireGuard sidecar to
# republish/forward storage ports; keep aligned across both stacks.
MINIO_API_PORT=12004
MINIO_CONSOLE_PORT=12015

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=pass998!
# MINIO_ACCESS_KEY must match MINIO_ROOT_USER in .env.storage
# MINIO_SECRET_KEY must match MINIO_ROOT_PASSWORD in .env.storage

# Optional overrides (auto-derived from STORAGE_SERVER_IP / APP_HOST when omitted):
# POSTGRES_HOST=
# MINIO_ENDPOINT=
# MINIO_PUBLIC_ENDPOINT=
# MINIO_CONSOLE_ENDPOINT=
# PUBLIC_GATEWAY_URL=
# OIDC_CALLBACK_URL=
# OIDC_FRONTEND_URL=
# OIDC_AUTHORIZATION_URL=
# AUTH_CORS_ORIGIN=
# KEYCLOAK_HOST=

# -----------------------------------------------------------------------------
# AI dashboard (/ai-service) — the separate falcon-ai-service stack
# -----------------------------------------------------------------------------
# Where the api-gateway proxies /ai-service. Omit both when the dashboard runs on
# the same host as this stack (defaults to http + host.docker.internal:3010).
# For a cross-host deploy, point at the dashboard's own TLS terminator over the
# private/tunnel address — its certificate is self-signed and not verified:
#   AI_DASHBOARD_PROTOCOL=https
#   AI_DASHBOARD_ENDPOINT=10.225.0.58:3001
# The dashboard must be built with basePath=/ai-service (NEXT_PUBLIC_BASE_PATH);
# the gateway does not strip the prefix.
# AI_DASHBOARD_PROTOCOL=
# AI_DASHBOARD_ENDPOINT=

# -----------------------------------------------------------------------------
# Authentication — falcon-auth + Keycloak (OIDC mandatory)
# Managed here for deploy-app / deploy-ghcr (.env.app). falcon-core uses JWT_SECRET.
# Browser URLs are derived from APP_HOST; server-side URLs use Docker service names.
# PUBLIC_GATEWAY_URL is also baked into the frontend build as VITE_API_URL.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Per-device sessions (falcon-auth `user_sessions` + admin termination).
# Redis is a cache only — Postgres stays authoritative, and an outage degrades
# to a DB read per request rather than failing open.
REDIS_HOST=falcon-redis
REDIS_PORT=6379
# TTL (seconds) of the positive "session is live" cache. Longer = fewer DB
# reads; termination still bites immediately because revoking writes the
# negative cache synchronously.
AUTH_SESSION_CACHE_TTL_S=30
# Reject access tokens that carry no `sid` claim. Leave false during rollout so
# tokens minted before per-device sessions keep working; flip to true once all
# of them have aged out (one JWT_EXPIRATION window).
AUTH_REQUIRE_SID=false

# Refuse known non-browser HTTP clients (curl, wget, python-requests, Postman,
# an empty User-Agent, …) on the session-creating auth routes, so humans sign in
# through the web app and machines stay on the API-key / X-API-Password paths.
# Note this is a hygiene control, not a security boundary — a spoofed
# User-Agent walks straight through it. Set to false to disable (local dev,
# or to unblock a runbook that still curls the login endpoint).
AUTH_BLOCK_NON_BROWSER_CLIENTS=true
# Optional: comma-separated User-Agent substrings that REPLACE the built-in
# blocklist. Leave empty to use the built-in list.
AUTH_BLOCKED_CLIENT_UAS=

OIDC_MANDATORY=true
OIDC_LOGIN_MODE=server
OIDC_CLIENT_ID=falcon-web
OIDC_CLIENT_SECRET=falcon-oidc-client-secret
OIDC_SCOPES="openid email profile roles"
# Internal Keycloak URLs are written to .env.app.runtime — do not hardcode OIDC_ISSUER here.
OIDC_ALLOW_INSECURE_REQUESTS=true

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=pass998!
KEYCLOAK_HOST_PORT=12140
# Used by falcon-auth to provision Settings-created users into Keycloak (server login mode).
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=falcon
# Let falcon-auth create missing Keycloak users by itself, so accounts predating
# server login mode heal automatically: on a local-fallback login the verified
# password is pushed to Keycloak, and a role change creates a credential-less
# user rather than failing. Set false where implicit identity creation is not
# acceptable and provisioning must stay manual
# (scripts/provision-keycloak-falcon-users.sh).
KEYCLOAK_AUTO_PROVISION=true
# Default falcon realm user (after reset): admin@falconai.com / Admin123!
# Settings → New User provisions into Keycloak automatically when OIDC_LOGIN_MODE=server.
# Backfill users created before that fix:
#   FALCON_USER='user@example.com' FALCON_PASS='...' bash scripts/provision-keycloak-falcon-users.sh

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# Optional — leave empty if unused
VIDEO_AI_API_URL=
YT_API_KEY=AIzaSyA7xr-nP61TWmSrylLziRD7oWXPHqis65Q
WORKER_API_PASSWORD=85234569495721

# External AI service (news + video analysis paths in core-service).
# The endpoint has a default in docker-compose.app.yml; the KEY does not, on
# purpose — it used to be committed as a literal, so that value is in git
# history and must be considered compromised. Rotate it upstream and set the
# new one here. Left empty, core sends no Authorization header and the call
# fails at the upstream, which is preferable to silently using a leaked key.
#
# Both retire when the Brain takes over these paths (P1-4b).
EXTERNAL_AI_API_URL=
EXTERNAL_AI_API_KEY=

# Technical Panel — per-lane VNC login (account routing). Hardcoded true in docker-compose;
# listed here for documentation / local overrides when not using compose defaults.
FB_MULTI_ACCOUNT_ENABLED=true
FB_REMOTE_EXTENSION_SCRAPING_ENABLED=true
LINKEDIN_MULTI_ACCOUNT_ENABLED=true
X_MULTI_ACCOUNT_ENABLED=true
WEB_WORKER_MULTI_ACCOUNT_ENABLED=true

# OpenSearch indexing (off by default — enable when core is up and you want auto-populate)
SEARCH_STARTUP_SEED=false
SEARCH_SYNC_ON_START=false
SOCIAL_SCRAPER_CONCURRENCY=10

# -----------------------------------------------------------------------------
# External integration gateway (falcon-gateway) — REQUIRED for the /api/external
# public API and outbound webhooks. Generate each secret with: openssl rand -hex 32
# -----------------------------------------------------------------------------
# 32-byte master key that encrypts client/webhook secrets at rest (AES-256-GCM).
GATEWAY_ENCRYPTION_KEY=
GATEWAY_INTERNAL_API_KEY=
GATEWAY_HMAC_SKEW_SECONDS=300
GATEWAY_DB_AUTO_INIT=true

# Telegram worker (optional — only if using worker-telegram scraper)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=
# TELEGRAM_PASSWORD=

# -----------------------------------------------------------------------------
# GHCR client deploy (image-only — no source build on this host)
# Leave GHCR_IMAGE_PREFIX empty to build from local source instead.
# -----------------------------------------------------------------------------
GHCR_IMAGE_PREFIX=ghcr.io/zionmezba/falconai
FALCON_IMAGE_TAG=latest
FALCON_DEPLOY_MODE=ghcr
FALCON_DEPLOY_DIR=/opt/falconai-client
#
# Auto-deploy after GitHub CI (notify-client webhook):
#   sudo bash scripts/deploy/setup-auto-deploy.sh
#   GitHub secrets: CLIENT_DEPLOY_WEBHOOK, CLIENT_DEPLOY_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# pcdn config sync (optional) — download compose/config bundle before deploy
# When enabled, each triggered deploy fetches the latest config bundle from
# pcdn BEFORE pulling GHCR images, so .env.app and compose files stay in sync.
# -----------------------------------------------------------------------------
PCDN_SYNC_ON_DEPLOY=true
PCDN_ENDPOINT=https://4sightdigi.com:8443
PCDN_PROJECT=falconai-client
PCDN_PASSWORD=fawz665#

# -----------------------------------------------------------------------------
# Docker build
# -----------------------------------------------------------------------------
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Tip: for fastest deploy, skip rebuilding images:
# BUILD_FLAG=0 make deploy-app

# Prune stopped containers (+ dangling images after app build). Set 0 to disable.
PRUNE_AFTER_BUILD=1
