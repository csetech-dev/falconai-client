// ============================================
// NEWS HEADLINES
// ============================================

model NewsHeadline {
  id String @id @default(cuid())

  // Core headline data
  title      String  @db.Text
  url        String
  source     String // e.g. "Reuters", "Bloomberg", "Al Jazeera"
  sourceUrl  String? // Source website base URL
  sourceLogo String? // Logo URL for the source
  author     String?

  // Content
  summary  String? @db.Text
  imageUrl String?
  category String? // e.g. "Politics", "Technology", "Business"

  // Deduplication
  contentHash String @unique // SHA-256 hash of title+url for dedup

  // Timing
  publishedAt DateTime? // When the article was published
  scrapedAt   DateTime  @default(now()) // When we scraped it

  // Classification & Analysis
  sentiment  Float? // -1 to 1
  isBreaking Boolean  @default(false)
  priority   Int      @default(0) // Higher = more important
  tags       String[] @default([])
  region     String? // Geographic region
  language   String?  @default("en")

  // Keyword matching
  matchedKeywords String[] @default([])

  // Optional link to campaign / scrape job
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Optional link to full scrape result for detailed analysis
  scrapeResultId String?       @unique
  scrapeResult   ScrapeResult? @relation(fields: [scrapeResultId], references: [id], onDelete: SetNull)

  // AI Hybrid Search (added by migration 002_ai_search)
  searchTsv        Unsupported("tsvector")?     @map("search_tsv") // Full-text search vector
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding") // BGE-M3 semantic embedding

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([category])
  @@index([publishedAt])
  @@index([scrapedAt])
  @@index([isBreaking])
  @@index([campaignId])
  @@index([priority])
  @@index([region])
  @@map("news_headlines")
}

model ProfileSnapshot {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Metrics at snapshot time
  followers      Int
  following      Int
  postsCount     Int
  engagementRate Float

  // Delta tracking (change from previous snapshot)
  followersDelta      Int? // Change in followers since last snapshot
  followingDelta      Int? // Change in following since last snapshot
  postsCountDelta     Int? // Change in posts since last snapshot
  engagementRateDelta Float? // Change in engagement rate

  // Growth rate (percentage)
  followersGrowthRate Float? // Percentage change in followers

  // Additional metrics
  avgLikes    Float?
  avgComments Float?
  avgShares   Float?

  // Timing
  snapshotAt DateTime @default(now())

  @@index([campaignId])
  @@index([snapshotAt])
  @@index([campaignId, snapshotAt])
  @@map("profile_snapshots")
}

model FollowerAnalytics {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Time period
  periodType  AnalyticsPeriod // HOURLY, DAILY, WEEKLY, MONTHLY, YEARLY
  periodStart DateTime // Start of the period
  periodEnd   DateTime // End of the period

  // Follower metrics for this period
  startFollowers Int // Followers at period start
  endFollowers   Int // Followers at period end
  netChange      Int // Net change (endFollowers - startFollowers)
  gained         Int @default(0) // New followers gained
  lost           Int @default(0) // Followers lost

  // Growth metrics
  growthRate     Float // Percentage change
  growthVelocity Float? // Rate of change per day

  // Comparative metrics
  avgDailyGrowth  Float? // Average daily growth in this period
  peakFollowers   Int? // Highest follower count in period
  lowestFollowers Int? // Lowest follower count in period

  // Additional engagement metrics for context
  avgEngagementRate Float?
  totalPosts        Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, periodType, periodStart])
  @@index([campaignId])
  @@index([periodType])
  @@index([periodStart])
  @@index([campaignId, periodType, periodStart])
  @@map("follower_analytics")
}

// ============================================
// AI ANALYSIS SYSTEM (Async Request/Webhook)
// ============================================

enum AIAnalysisType {
  PROFILE
  POST
  NEWS
  FACT_CHECK
  VIDEO
}

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model AIAnalysisRequest {
  id String @id @default(cuid())

  // Request type
  analysisType AIAnalysisType
  status       AIAnalysisStatus @default(PENDING)

  // Reference IDs (one of these will be set based on analysisType)
  campaignId       String? // For PROFILE analysis
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  postId           String? // For POST analysis
  newsQueryParams  Json? // For NEWS analysis (search params, date range, etc.)
  factCheckContext Json? // For FACT_CHECK analysis (top sources + trigger metadata)

  // External AI integration
  externalRequestId String? // ID returned by external AI service
  callbackUrl       String? // Webhook URL for the external AI to call back

  // API reference for external AI to fetch data
  dataApiUrl      String? @db.Text // The API URL external AI should use to fetch data
  responsePayload Json? // Stores callback response payload for transient UI consumption

  // Error handling
  errorMessage String? @db.Text
  retryCount   Int     @default(0)
  maxRetries   Int     @default(3)

  // Timing
  requestedAt  DateTime  @default(now())
  processingAt DateTime? // When external AI started processing
  completedAt  DateTime? // When results were received
  expiresAt    DateTime? // Request expiration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Inverse: a FACT_CHECK run produces one persisted SocialPostFactCheck row
  factCheckResult SocialPostFactCheck?

  @@index([analysisType])
  @@index([status])
  @@index([campaignId])
  @@index([postId])
  @@index([externalRequestId])
  @@map("ai_analysis_requests")
}

/// Persisted fact-check results for social posts. One row per AI run; the most
/// recent run for a post is marked isLatest=true (maintained transactionally).
/// History is preserved so the verdict timeline can be inspected over time.
model SocialPostFactCheck {
  id                String             @id @default(cuid())
  postId            String
  post              SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  analysisRequestId String?            @unique
  analysisRequest   AIAnalysisRequest? @relation(fields: [analysisRequestId], references: [id], onDelete: SetNull)

  // Verdict + scores
  verdict      String // true | partially_verified | misleading | unverified | not_fact_checkable
  overallScore Int // 0-100
  confidence   Int // 0-100
  summary      String @db.Text

  // Per-metric scores (columns so dashboards can filter without JSON ops)
  sourceCredibility  Int
  contentConsistency Int
  factualAccuracy    Int
  biasDetection      Int

  // Sources + per-source AI reviews (full evidence chain, replayable)
  articleReviews     Json // [{ id, originalMatchScore, aiMatchScore, finalMatchScore, verdict, role, reason }, ...]
  sourcesFingerprint String // sha1(sorted source IDs) — cache key for "same evidence set"
  sourceCount        Int

  // Claim package snapshot (what we asked the AI)
  claimText     String  @db.Text
  claimType     String // factual_event | policy_statement | quote_or_attribution | opinion_or_reaction | personal_or_greeting
  factCheckable Boolean

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv        Unsupported("tsvector")?     @map("search_tsv")
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")

  // History bookkeeping
  isLatest    Boolean  @default(true)
  triggeredBy String? // auto | manual_rerun | <x-user-id>
  createdAt   DateTime @default(now())

  @@index([postId, isLatest])
  @@index([postId, createdAt(sort: Desc)])
  @@index([verdict])
  @@map("social_post_fact_checks")
}

model ProfileAIAnalytics {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Analysis metadata
  lastAnalyzedAt DateTime @default(now())

  // Profile Summary
  profileSummary String  @db.Text
  topic          String? // Main topic/theme of the profile

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv        Unsupported("tsvector")?     @map("search_tsv")
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")

  // Next Post Prediction
  nextPostContentType      String?
  nextPostLikelyTopic      String? @db.Text
  nextPostContentStyle     String?
  nextPostTimingPrediction String?
  nextPostPredictedSample  String? @db.Text

  // Engagement Prediction
  expectedLikesMin    Int?
  expectedLikesMax    Int?
  expectedCommentsMin Int?
  expectedCommentsMax Int?
  expectedSharesMin   Int?
  expectedSharesMax   Int?
  engagementRateMin   Float?
  engagementRateMax   Float?
  viralPotential      String? // LOW, MEDIUM, HIGH, VERY_HIGH

  // Content Analysis
  mainThemes         String[] @default([])
  engagementTriggers String[] @default([])
  languageStyle      String?

  // Audience Insights
  audienceDemographics Json? // Flexible JSON for demographics breakdown
  activeHours          String[] @default([])
  topLocations         String[] @default([])

  // Overall Sentiment
  sentimentScore     Int? // 0-100
  sentimentLabel     String? // POSITIVE, NEGATIVE, NEUTRAL, MIXED
  sentimentBreakdown Json? // {positive: 68, neutral: 25, negative: 7}

  // Viral Potential Analysis
  viralPotentialScore Int? // 0-100
  viralFactors        String[] @default([])

  // Best Posting Time
  bestPostingTime    String?
  suggestedTopics    String[] @default([])
  expectedEngagement String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Provenance of the model+prompt that produced this row. Mirrors the
  /// pattern TrendingCategoryIntelligence already carries. Without it, a
  /// quality change cannot be attributed to a model or prompt, and the row
  /// cannot be filtered out of a training set built from a known-bad run.
  modelProvider  String? // provider id at generation time (e.g. brain, cortex)
  modelName      String? // model actually served, as reported by the upstream
  promptVersion  String? // promptKind of the request (see ai-output-token-settings)
  promptHash     String? // sha256[0..16] of the rendered prompt — detects silent template edits
  generationMeta Json? // latency, attempts, finish_reason

  @@index([campaignId])
  @@index([lastAnalyzedAt])
  @@map("profile_ai_analytics")
}

model PostAIAnalysis {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Analysis metadata
  lastAnalyzedAt DateTime @default(now())

  // Post Summary
  summary String @db.Text

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv        Unsupported("tsvector")?     @map("search_tsv")
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")

  // Single-sentence Bengali rationale: WHY this post is viral. Combines
  // content (topic / emotional weight) with comparative signal (velocity
  // vs channel baseline, share-to-reaction ratio). Surfaced in the
  // Investigation / viral-posts cards as the lead "Why this is viral?" line.
  viralityRationale String? @db.Text

  // Overall Sentiment
  sentimentScore     Float? // -1 to 1 or 0-100
  sentimentLabel     String? // POSITIVE, NEGATIVE, NEUTRAL, MIXED
  sentimentBreakdown Json? // {positive: 60, neutral: 25, negative: 15}

  // Viral Potential
  viralPotentialScore Float? // 0 to 100
  viralPotentialLabel String? // LOW, MEDIUM, HIGH, VIRAL
  viralFactors        Json? // [{factor, impact, description}, ...]

  // Audience Insights
  audienceDemographics Json? // {techProfessionals: 45, founders: 20, developers: 25, other: 10}
  activeHours          String[] @default([]) // Peak engagement hours
  topLocations         String[] @default([])

  // Content Analysis
  mainThemes         String[] @default([])
  engagementTriggers String[] @default([])
  keywords           String[] @default([])
  languageStyle      String?
  toneAnalysis       String? // Informative, Persuasive, Emotional, etc.

  // Engagement Prediction
  expectedLikes    Int?
  expectedComments Int?
  expectedShares   Int?
  engagementRate   Float?

  // AI Recommendations
  aiRecommendations Json? // {intro, concerns: [{title, description}], proposedActions: [...]}

  // Risk Assessment
  riskAssessment Json? // {overallRisk, riskScore, categories: [{category, level, score}]}

  // Detected Entities
  detectedEntities Json? // {organizations: [], people: [], topics: [], locations: []}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Provenance of the model+prompt that produced this row. Mirrors the
  /// pattern TrendingCategoryIntelligence already carries. Without it, a
  /// quality change cannot be attributed to a model or prompt, and the row
  /// cannot be filtered out of a training set built from a known-bad run.
  modelProvider  String? // provider id at generation time (e.g. brain, cortex)
  modelName      String? // model actually served, as reported by the upstream
  promptVersion  String? // promptKind of the request (see ai-output-token-settings)
  promptHash     String? // sha256[0..16] of the rendered prompt — detects silent template edits
  generationMeta Json? // latency, attempts, finish_reason

  @@index([postId])
  @@index([lastAnalyzedAt])
  @@map("post_ai_analysis")
}

model NewsAIAnalysis {
  id String @id @default(cuid())

  // Article reference (optional — null for aggregate/bulk analysis)
  articleId String?
  article   NewsArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // Analysis metadata
  lastAnalyzedAt DateTime @default(now())
  analysisScope  String? // "daily", "weekly", "custom", "category:politics"

  // Query params used for this analysis
  queryParams Json? // {startDate, endDate, category, source, search}

  // Overall Sentiment Analysis
  overallSentimentScore Float? // -1 to 1 or 0-100
  overallSentimentLabel String? // POSITIVE, NEGATIVE, NEUTRAL, MIXED
  sentimentBreakdown    Json? // {positive: 40, neutral: 35, negative: 25}
  sentimentByCategory   Json? // {politics: {score, label}, tech: {score, label}, ...}
  sentimentBySource     Json? // {bbc: {score, label}, cnn: {score, label}, ...}

  // Trending Keywords
  trendingKeywords Json? // [{keyword, count, trend, sentiment}, ...]
  emergingTopics   String[] @default([])
  decliningTopics  String[] @default([])

  // Topic Analysis
  topTopics     Json? // [{topic, articleCount, avgSentiment}, ...]
  topicClusters Json? // Grouped related topics

  // Key Insights
  summary     String?  @db.Text // AI-generated summary of news landscape
  keyFindings String[] @default([])
  alerts      Json? // [{type, message, severity}, ...]

  // Detailed Analysis
  detailedInsights String?  @db.Text // Comprehensive multi-paragraph analysis
  potentialBiases  String?  @db.Text // Detected biases in sources
  recommendations  String[] @default([]) // Actionable recommendations

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv        Unsupported("tsvector")?     @map("search_tsv")
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")
  articleStats     Json? // {totalArticles, analyzedArticles, positiveArticles, negativeArticles, neutralArticles}

  // Source Analysis
  sourceReliability Json? // {source: reliabilityScore, ...}
  sourceBreakdown   Json? // {source: articleCount, ...}

  // Country-to-country relation extraction when present in article context
  relation     Json? // {from: "bangladesh", to: "usa"}
  // Indexed denormalized fields for Worldwide Bangladesh Coverage map queries
  relationFrom String?
  relationTo   String?

  // Temporal Analysis
  volumeTrend    Json? // [{date, count}, ...] article volume over time
  sentimentTrend Json? // [{date, sentiment}, ...] sentiment over time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Provenance of the model+prompt that produced this row. Mirrors the
  /// pattern TrendingCategoryIntelligence already carries. Without it, a
  /// quality change cannot be attributed to a model or prompt, and the row
  /// cannot be filtered out of a training set built from a known-bad run.
  modelProvider  String? // provider id at generation time (e.g. brain, cortex)
  modelName      String? // model actually served, as reported by the upstream
  promptVersion  String? // promptKind of the request (see ai-output-token-settings)
  promptHash     String? // sha256[0..16] of the rendered prompt — detects silent template edits
  generationMeta Json? // latency, attempts, finish_reason

  @@index([lastAnalyzedAt])
  @@index([analysisScope])
  @@index([articleId])
  @@index([overallSentimentLabel])
  @@index([articleId, overallSentimentLabel])
  @@index([overallSentimentLabel, lastAnalyzedAt])
  @@index([relationFrom, relationTo])
  @@index([relationFrom])
  @@index([relationTo])
  @@index([relationFrom, relationTo, lastAnalyzedAt])
  @@map("news_ai_analysis")
}

