// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, unaccent]
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  USER
  MODERATOR
  TECHNICAL
  AI_SERVICE
  API_CLIENT
}

enum AuthProvider {
  LOCAL
  OIDC
  SAML
}

enum PermissionAction {
  READ
  CREATE
  EDIT
  DELETE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ScrapeJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TERMINATED
}

enum SocialAccountStatus {
  ACTIVE
  NEEDS_LOGIN
  COOLDOWN
  DISABLED
  ERROR
}

enum SocialLaneExecutionMode {
  LOCAL
  REMOTE_EXTENSION
}

enum RemoteExtensionHostStatus {
  PENDING
  ONLINE
  OFFLINE
  REVOKED
}

enum RemoteLaneCommandStatus {
  PENDING
  DISPATCHED
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum ScrapePlatform {
  TWITTER
  FACEBOOK
  LINKEDIN
  WEB_WORKER
  NEWS
  TELEGRAM
  VIDEO
  YOUTUBE
}

enum EntityType {
