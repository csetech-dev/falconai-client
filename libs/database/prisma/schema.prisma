  cacheKey          String   @unique
  keywordCategoryId String?
  campaignId        String?
  searchQuery       String?
  sourcesKey        String?
  startDate         String?
  endDate           String?
  articleCount      Int      @default(0)
  dbKeywordRows     Json?
  aiKeywordRows     Json?
  lastBuiltAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([keywordCategoryId])
  @@index([campaignId])
  @@index([expiresAt])
  @@map("news_search_panel_cache")
}

// Individual group identification
model NewsMediaSource {
