// All the news papers
model NewsSource {
  id                String          @id @default(cuid())
  name              String
  normalizedName    String          @unique
  officialWebsite   String          @unique
  logoUrl           String?
  sourceType        NewsSourceType? @default(main_stream)
  /// True when this source was created/synced from News Studio builder configs.
  /// Sticky: once true, hardcoded catalog sync must not clear it.
  isBuiltFromStudio Boolean         @default(false) @map("is_built_from_studio")
  isTop             Boolean         @default(false) @map("is_top")
  isTodays          Boolean         @default(false) @map("is_todays")
  isTrending        Boolean         @default(false) @map("is_trending")

  articles   NewsArticle[]
  mediaLinks NewsMediaSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_sources_name_trgm_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_sources_normalized_name_trgm_idx")
  @@index([officialWebsite])
  @@index([officialWebsite(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_sources_website_trgm_idx")
  @@index([sourceType])
  @@index([isBuiltFromStudio])
  @@index([isTop])
  @@index([isTodays])
  @@index([isTrending])
  @@map("news_sources")
}

enum NewsSourceType {
  main_stream
  local_stream
  international_stream
}

// Group of news papers (Print Media)
model NewsMedia {
  id             String  @id @default(cuid())
  name           String
  description    String? @db.Text
  color          String  @default("#06b6d4")
  sortOrder      Int     @default(0)
  isBottomTicker Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaigns Campaign[]
  articles  NewsArticle[]
  sources   NewsMediaSource[] // id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_media_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_media_description_trgm_idx")
  @@index([sortOrder])
  @@index([isBottomTicker])
  @@map("news_media")
}

model NewsArticle {
  id                String           @id @default(cuid())
  scrapeResultId    String?          @unique
  scrapeResult      ScrapeResult?    @relation(fields: [scrapeResultId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          Campaign?        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaId           String?
  media             NewsMedia?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  sourceId          String?
  source            NewsSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  keywordCategoryId String?
  keywordCategory   KeywordCategory? @relation(fields: [keywordCategoryId], references: [id], onDelete: SetNull)
  divisionId        String?
  division          Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  districtId        String?
  district          District?        @relation(fields: [districtId], references: [id], onDelete: SetNull)

  sourceWebsite       String
  author              String?
  title               String?
  url                 String?
  /// Scrape provenance, e.g. /news/top_news or seed-news-media-group:print-media
  origin              String?
  publishedAt         DateTime? // AI-normalized publication wall-clock
  scrapedAt           DateTime? // Worker scraped_at wall-clock
  rawPublishedAt      String? // Raw date string from news worker
  rawScrapedAt        String? // Raw scraped date string from news worker
  category            String?
  imageUrl            String?
  content             String?    @db.Text // Full article content
  contentHash         String     @unique // SHA-256 hash for deduplication
  status              NewsStatus @default(NOT_ANALYZED)
  aiAnalysisStatus    String?    @default("PENDING")
  analysisStatus      String?    @default("PENDING")
  // Set when an AI automation worker claims this row (status -> PROCESSING).
  // NewsArticle has no updatedAt, so this is what the stale-claim reaper uses.
  aiAnalysisClaimedAt DateTime?

  isAlarmingIncident Boolean   @default(false)
  isAcknowledged     Boolean   @default(false)
  /// Who acknowledged it. `isAcknowledged`/`acknowledgedAt` recorded that an
  /// article was judged handled, and when, but never by whom — so the decision
  /// was unattributable and unauditable.
  acknowledgedBy     String?   @map("acknowledged_by")
  alarmedAt          DateTime?
  acknowledgedAt     DateTime?

  // AI Hybrid Search (added by migration 002_ai_search)
  /// Dominant script of the content, from libs/bangla-text `detectScript`:
  /// "bangla" | "latin" | "mixed" | "other". Reliable — it is a codepoint test.
  script         String?
  /// Best-effort content language: "bn" | "en" | "mixed".
  /// CAVEAT: derived from script, so Banglish (Bangla written in Latin script)
  /// is currently filed as "en". Fixing that needs the romanization key (P2-7),
  /// not a better heuristic here.
  language       String?
  searchTsv      Unsupported("tsvector")?     @map("search_tsv") // Full-text search vector
  titleEmbedding Unsupported("vector(1024)")? @map("title_embedding") // BGE-M3 semantic embedding

  newsAIAnalyses NewsAIAnalysis[]
  keywordLinks   NewsArticleKeyword[]

  createdAt DateTime @default(now())

  @@index([category])
  @@index([sourceWebsite])
  @@index([contentHash])
  @@index([campaignId])
  @@index([campaignId, scrapedAt])
  @@index([status])
  @@index([status, scrapedAt])
  @@index([status, publishedAt])
  @@index([aiAnalysisStatus])
  @@index([analysisStatus])
  @@index([mediaId])
  @@index([mediaId, publishedAt])
  @@index([sourceId])
  @@index([sourceId, scrapedAt])
  @@index([sourceId, publishedAt])
  @@index([keywordCategoryId])
  @@index([keywordCategoryId, scrapedAt])
  @@index([keywordCategoryId, publishedAt])
  @@index([publishedAt])
  @@index([scrapedAt])
  @@index([origin])
  @@index([origin, publishedAt])
  @@index([status, origin, publishedAt])
  @@index([divisionId])
  @@index([districtId])
  @@index([divisionId, sourceId, scrapedAt])
  @@index([districtId, sourceId, scrapedAt])
  @@index([isAlarmingIncident, isAcknowledged, divisionId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "news_articles_title_trgm_idx")
  @@map("news_articles")
}

model NewsArticleKeyword {
  id            String      @id @default(cuid())
  newsArticleId String
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  keywordId     String
  keyword       Keyword     @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([newsArticleId, keywordId])
  @@index([newsArticleId])
  @@index([keywordId])
  @@index([keywordId, newsArticleId])
  @@map("news_article_keywords")
}

model NewsSearchPanelCache {
  id                String    @id @default(cuid())
  cacheKey          String    @unique
  keywordCategoryId String?
  campaignId        String?
  searchQuery       String?
  sourcesKey        String?
  startDate         String?
  endDate           String?
  articleCount      Int       @default(0)
  dbKeywordRows     Json?
  aiKeywordRows     Json?
  lastBuiltAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([keywordCategoryId])
  @@index([campaignId])
  @@index([expiresAt])
  @@map("news_search_panel_cache")
}

// Individual group identification
model NewsMediaSource {
  id        String     @id @default(cuid())
  mediaId   String
  media     NewsMedia  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sourceId  String
  source    NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([mediaId, sourceId])
  @@index([mediaId])
  @@index([sourceId])
  @@map("news_media_sources")
}

model Division {
  id        String   @id @default(cuid())
  name      String
  nameBn    String?
  code      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts    District[]
  newsArticles NewsArticle[]

  @@unique([name])
  @@unique([nameBn])
  @@index([code])
  @@map("divisions")
}

model District {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name       String
  nameBn     String?
  code       String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  newsArticles NewsArticle[]

  @@unique([divisionId, name])
  @@unique([divisionId, nameBn])
  @@index([divisionId])
  @@index([code])
  @@map("districts")
}

