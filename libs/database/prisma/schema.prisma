// All the news papers
model NewsSource {
  id               String            @id @default(cuid())
  name             String
  normalizedName   String            @unique
  officialWebsite  String            @unique
  logoUrl          String?
  sourceType       NewsSourceType?   @default(main_stream)

  articles         NewsArticle[]
  mediaLinks       NewsMediaSource[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([name])
  @@index([officialWebsite])
  @@index([sourceType])
  @@map("news_sources")
}

enum NewsSourceType {
  main_stream
  local_stream
  international_stream
}

// Group of news papers (Print Media)
model NewsMedia {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  color       String            @default("#06b6d4")
  sortOrder   Int               @default(0)
  isBottomTicker Boolean        @default(false)

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaigns   Campaign[]
  articles    NewsArticle[]
  sources     NewsMediaSource[] // id

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([sortOrder])
  @@index([isBottomTicker])
