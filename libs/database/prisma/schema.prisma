// ============================================
// MODELS
// ============================================

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  username          String?
  password          String?
  firstName         String?
  lastName          String?
  avatarUrl         String? // bare MinIO object key: avatars/<userId>/<uuid>.<ext>
  designation       String?
  employeeId        String?
  roles             UserRole[]   @default([USER])
  isActive          Boolean      @default(true)
  phone             String? // E.164, used by the SMS 2FA channel
  phoneVerified     Boolean      @default(false)
  authProvider      AuthProvider @default(LOCAL)
  externalSubjectId String?
  refreshToken      String?
  lastLogin         DateTime?
  apiKey            String?
  apiRequestCount   Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  campaigns         Campaign[]
  keywords          Keyword[]
  keywordCategories KeywordCategory[]
  newsMedia         NewsMedia[]
  groups            Group[]

  reports              Report[]
  reportTemplates      ReportTemplate[]
  reportVersions       ReportVersion[]      @relation("ReportVersionAuthor")
  reportCollaborations ReportCollaborator[]
  notifications        UserNotification[]
  permissions          UserPermission[]

  reportBookmarks     ReportBookmark[]
  bookmarkCollections BookmarkCollection[]
  twoFactor           UserTwoFactor?
  chatThreads         ChatThread[]
  sessions            UserSession[]

  @@map("users")
}

/// One row per authenticated device/browser. Created at token issuance, rotated on
/// refresh, revoked on logout / admin terminate. Like user_two_factor, falcon-auth
/// owns the reads/writes via raw SQL on its TypeORM DataSource (it has no Prisma
/// client), so this model must never be registered as a TypeORM entity.
model UserSession {
  id               String    @id // == the `sid` JWT claim; uuid supplied by falcon-auth
  userId           String
  refreshTokenHash String? // sha256 hex of the CURRENT refresh token
  prevTokenHash    String? // sha256 of the previous token (rotation-race grace window)
  prevRotatedAt    DateTime?
  ipAddress        String?
  userAgent        String?   @db.Text
  deviceLabel      String? // "Chrome on Windows", derived from the UA at create time
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedBy        String? // actor userId; null = self/system
  revokedReason    String? // logout | admin_terminate | password_change | user_deactivated

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

// 2FA enrollment state (Phase 1: TOTP). Kept in a separate 1:1 table so the
// falcon-auth TypeORM User entity stays untouched — falcon-auth reads/writes
// these rows via raw SQL on its DataSource.
model UserTwoFactor {
  userId        String    @id
  totpSecretEnc String?   @db.Text // AES-256-GCM encrypted TOTP secret
  enrolledAt    DateTime?
  backupCodes   String[]  @default([]) // sha256 hashes of unused one-time codes
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor")
}

// One row per pending login/enrollment challenge (5-minute lifetime).
// Tracks attempt counts server-side so codes can't be brute-forced.
model TwoFactorChallenge {
  id               String    @id @default(cuid())
  userId           String
  purpose          String // 'login' | 'enroll'
  channel          String    @default("totp") // 'totp' | 'email' | 'sms'
  pendingSecretEnc String?   @db.Text // enroll: encrypted candidate TOTP secret
  pendingPhone     String? // sms enroll: phone being verified (saved on success)
  codeHash         String? // email/sms: sha256 of the delivered 6-digit code
  lastSentAt       DateTime? // email/sms: resend cooldown anchor
  attempts         Int       @default(0)
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

model UserPermission {
  id         String           @id @default(cuid())
  userId     String
  resource   String
  action     PermissionAction
  resourceId String           @default("*")
  grantedBy  String
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action, resourceId])
  @@map("user_permissions")
}

model NotificationTypeConfig {
  id                 String   @id @default(cuid())
  code               String   @unique
  label              String
  description        String?  @db.Text
  source             String?
  category           String?
  enabled            Boolean  @default(true)
  defaultTitle       String?
  defaultActionLabel String?
  defaultActionUrl   String?
  deliveryConfig     Json?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  notifications UserNotification[]

  @@index([enabled, source])
  @@index([category])
  @@map("notification_type_configs")
}

model UserNotification {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationTypeId String
  notificationType   NotificationTypeConfig @relation(fields: [notificationTypeId], references: [id], onDelete: Cascade)
  status             NotificationStatus     @default(UNREAD)
  priority           NotificationPriority   @default(MEDIUM)
  title              String
  message            String?                @db.Text
  shortMessage       String?                @db.Text
  source             String?
  eventKey           String?
  dedupeKey          String?
  actionLabel        String?
  actionUrl          String?
  entityType         String?
  entityId           String?
  metadata           Json?
  seenAt             DateTime?
  readAt             DateTime?
  dismissedAt        DateTime?
  archivedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  topicCategoryKey   String?
  topicCategoryLabel String?

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([notificationTypeId, status])
  @@index([priority, createdAt])
  @@index([eventKey])
  @@index([dedupeKey])
  @@index([entityType, entityId])
  @@index([userId, topicCategoryKey, createdAt])
  @@map("user_notifications")
}

model Group {
  id          String          @id @default(cuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        GroupTargetType
  color       String          @default("#6b7280")
  icon        String          @default("Layers")
  description String?         @db.Text
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items     GroupItem[]
  postCache GroupPostCache[]

  @@unique([userId, type, name])
  @@index([userId])
  @@index([type])
  @@map("groups")
}

model GroupItem {
  id         String          @id @default(cuid())
  groupId    String
  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  targetId   String
  targetType GroupTargetType
  createdAt  DateTime        @default(now())

  @@unique([groupId, targetId, targetType])
  @@index([groupId])
  @@index([targetId, targetType])
  @@map("group_items")
}

model ProfileGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   @default("general")
  color       String   @default("#6b7280")
  icon        String   @default("Layers")
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ProfileGroupItem[]

  @@map("profile_groups")
}

model ProfileGroupItem {
  id             String       @id @default(cuid())
  profileGroupId String
  profileGroup   ProfileGroup @relation(fields: [profileGroupId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([profileGroupId, campaignId])
  @@index([profileGroupId])
  @@index([campaignId])
  @@map("profile_group_items")
}

model ProfileIdentityMember {
  id         String   @id @default(cuid())
  clusterId  String
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([clusterId])
  @@map("profile_identity_members")
}

model Campaign {
  id       String         @id @default(cuid())
  name     String
  keywords String[] // Array of keywords for the campaign
  status   CampaignStatus @default(DRAFT)
  platform ScrapePlatform @default(NEWS)

  // News scraping parameters (optional)
  sources     String[] @default([])
  timeRange   String?
  maxArticles Int?

  // === MERGED FROM SocialProfile ===
  // Profile identification (for social campaigns)
  username    String?
  displayName String?
  profileType ProfileType     @default(PERSONAL)
  actionType  ActionType      @default(MONITOR)
  priority    ProfilePriority @default(MEDIUM)
  verified    Boolean         @default(false)
  autoScrape  Boolean         @default(false)
  bio         String?         @db.Text
  avatarUrl   String?
  profileUrl  String?

  // Contact Info
  email       String?
  phone       String?
  designation String?
  address     String?
  city        String?
  country     String?
  hometown    String?

  // Social Links
  website      String?
  twitterUrl   String?
  instagramUrl String?
  facebookUrl  String?
  linkedinUrl  String?
  tiktokUrl    String?
  youtubeUrl   String?

  // Metrics (current)
  followers      Int   @default(0)
  following      Int   @default(0)
  postsCount     Int   @default(0)
  engagementRate Float @default(0)

  // Additional
  tags             String[]  @default([])
  work             Json?
  education        Json?
  notes            String?   @db.Text
  lastScrapedAt    DateTime?
  aiAnalysisStatus String?   @default("PENDING")
  // === END MERGED FIELDS ===

  // === BOT DETECTION (commenter suspicion) ===
  // Populated only for NON_MONITOR campaigns (commenters); MONITOR profiles always remain CLEAN.
  suspicionStatus     SuspicionStatus @default(CLEAN)
  suspicionScore      Float?
  suspicionFlags      Json?
  suspiciousAt        DateTime?
  suspicionReviewedBy String?
  suspicionReviewedAt DateTime?
  /// Reviewer's free-text reason. `ReviewCommenterDto` has always accepted a
  /// `note` and validated it, then dropped it on the floor — there was nowhere
  /// to put it. It is worth more per row than the verdict: the status says a
  /// human disagreed with the score, the note says why.
  suspicionReviewNote String?         @db.Text
  suspicionLastScanAt DateTime?
  // === END BOT DETECTION ===

  // AI Hybrid Search (added by migration 002_ai_search)
  searchTsv        Unsupported("tsvector")?     @map("search_tsv") // Full-text search vector
  profileEmbedding Unsupported("vector(1024)")? @map("profile_embedding") // BGE-M3 semantic embedding

  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsMediaId String?
  newsMedia   NewsMedia? @relation(fields: [newsMediaId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  jobs                ScrapeJob[]
  trends              TrendSnapshot[]
  campaignKeywords    CampaignKeyword[]
  posts               SocialPost[]
  snapshots           ProfileSnapshot[]
  followerAnalytics   FollowerAnalytics[]
  checkins            SocialCheckin[]
  aiAnalytics         ProfileAIAnalytics[]
  aiAnalysisRequests  AIAnalysisRequest[]
  sharedPosts         PostShare[]            @relation("SharerProfile")
  reactions           PostReaction[]         @relation("ReactorProfile")
  newsHeadlines       NewsHeadline[]
  newsArticles        NewsArticle[]
  feedbacks           ProfileFeedback[]
  postComments        PostComment[]
  wildSearchBookmarks WildSearchBookmark[]
  videos              Video[]
  videoSnapshots      VideoSnapshot[]
  profileGroupItems   ProfileGroupItem[]
  identityMember      ProfileIdentityMember?

  @@unique([platform, username])
  @@index([userId])
  @@index([platform])
  @@index([status])
  @@index([autoScrape])
  @@index([newsMediaId])
  @@index([actionType, suspicionStatus])
  @@index([suspicionStatus])
  @@map("campaigns")
}

model SocialCheckin {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title     String
  location  String
  visitedOn String
  placeUrl  String?
  pageId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([pageId])
  @@map("social_checkins")
}

model ScrapeJob {
  id String @id @default(cuid())

  // Campaign scrapes (for both campaign-based and profile-based scraping)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Post-level scrapes: comments, shares (optional)
  postId String?
  post   SocialPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Video-level scrapes (video snapshot pipeline). A YouTube video has no
  // social_post, so its snapshot follow-up / recurring jobs reference the
  // videos row directly. Nullable + independent of postId: a FB video snapshot
  // job still uses postId (it lives in social_post), a YouTube one uses videoId.
  videoId String? @map("video_id")
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  status   ScrapeJobStatus @default(PENDING)
  platform ScrapePlatform
  priority JobPriority     @default(MEDIUM)

  // Error handling
  errorMessage String? @db.Text
  errorCode    String?
  retryCount   Int     @default(0)

  // Interval
  interval    Int? // Duration in seconds
  startedAt   DateTime?
  completedAt DateTime?

  // Progress tracking
  itemsProcessed Int    @default(0)
  itemsTotal     Int?
  progress       Float? // 0-100 percentage

  // Rate limiting / Scheduling
  lastRunAt DateTime?
  nextRunAt DateTime?

  // Worker assignment
  workerId String?

  // Job metadata (platform-specific config: hours, days, maxComments, etc.)
  config Json?

  // Coarse job classification / lifecycle tag (e.g. PROFILE_INFO, SNAPSHOT_FOLLOWUP, SNAPSHOT_MONITOR_RECURRING)
  notes String? @db.Text

  // Social account routing — which lane/account handled this job.
  // Kept on history when an account is removed (SetNull).
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  results   ScrapeResult[]

  @@index([campaignId])
  @@index([postId])
  @@index([videoId])
  @@index([status])
  @@index([priority])
  @@index([nextRunAt])
  @@index([workerId])
  @@index([socialAccountId])
  @@map("scrape_jobs")
}

model SystemConf {
  key       String   @id
  value     String   @db.Text
  /// Default so the column backfills on existing rows; @updatedAt keeps
  /// it current thereafter. Before this, a settings change left no trace
  /// at all — a quality regression could not be tied to the edit that
  /// caused it.
  updatedAt DateTime @default(now()) @updatedAt

  @@map("system_conf")
}

/// Append-only history of prompt-template edits.
///
/// Only keys containing "prompt" are recorded — `system_conf` also holds
/// scheduler state and caches that rewrite every cycle, and versioning those
/// would bury the signal in noise.
///
/// Attribution comes from `user_audit_events`: technical-panel is one of the
/// four audited resources, so the actor and timestamp are already recorded
/// there. This table supplies the value; joining on time gives you who.
///
/// Together with the AI-row provenance columns (X-1) this answers "which
/// template produced this analysis" — by time window, since a row's
/// promptHash covers the rendered prompt, not the template.
model SystemConfVersion {
  id        String   @id @default(cuid())
  key       String
  value     String   @db.Text
  /// sha256[0..16] of `value`. Cheap change detection without comparing
  /// multi-kilobyte templates.
  valueHash String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
  @@map("system_conf_versions")
}

// ============================================
// SOCIAL ACCOUNT ROUTING
// Multi-account scraping (starting with worker-fb). Each SocialAccount is a
// "lane": an isolated Chrome profile + a pinned proxy IP + its own VNC display.
// The worker's LaneManager load-balances scrape jobs across enabled, healthy
// lanes. This table is the management/source-of-truth plane (CRUD from the
// Technical Panel); the worker pulls the registry and pushes health back.
// ============================================

model SocialAccount {
  id String @id @default(cuid())

  platform ScrapePlatform @default(FACEBOOK)
  label    String // admin-friendly display name
  username String? // optional, for display only

  // Lane identity — deterministically derives the worker's per-lane resources
  // (Chrome profile dir, Xvfb display :100+i, x11vnc 5900+i, noVNC 7900+i).
  // Unique per platform so future platforms can reuse lane numbers.
  laneIndex Int

  status                SocialAccountStatus     @default(NEEDS_LOGIN)
  enabled               Boolean                 @default(true)
  priority              Int                     @default(100) // load-balancer weight (higher = preferred)
  maxConcurrent         Int                     @default(1) // jobs at once on this lane (lane stays serialized)
  // LOCAL lanes run Chrome inside worker-fb. REMOTE_EXTENSION lanes borrow a
  // paired Chrome extension's browser environment while worker-fb retains all
  // scraping/parsing responsibilities.
  executionMode         SocialLaneExecutionMode @default(LOCAL)
  remoteExtensionHostId String?                 @unique

  // Proxy binding — ONE pinned IP per lane (picked from system_conf proxy.list).
  proxyUrl String? @db.Text

  // Platform auth metadata. Used by the Telegram technical-panel auth flow to
  // persist official API credentials and session state in the DB instead of
  // worker-local environment variables.
  authPhone            String?
  authApiId            String?
  authApiHash          String?   @db.Text
  authPhoneCodeHash    String?   @db.Text
  authSessionPath      String?   @db.Text
  authSessionExists    Boolean   @default(false)
  authLastAuthorizedAt DateTime?

  // Health / telemetry — written back by the worker.
  cookieValid           Boolean   @default(false)
  cookieExpiresAt       DateTime?
  lastUsedAt            DateTime?
  lastSuccessAt         DateTime?
  lastErrorAt           DateTime?
  lastError             String?   @db.Text
  consecutiveFailures   Int       @default(0)
  rateLimitedUntil      DateTime?
  jobsToday             Int       @default(0)
  totalJobs             Int       @default(0)
  dailyJobLimit         Int?      @default(200) // max jobs/day for this lane; null = unlimited (default 200)
  // Daily TIME budget — a second, parallel throttle to dailyJobLimit. A lane
  // stops accepting NEW jobs when EITHER the job cap OR the time cap is hit.
  // Enforced in worker-fb lane_manager.try_acquire; null/0 = unlimited.
  dailyTimeLimitSeconds Int?      @default(0) // max active seconds/day; null/0 = unlimited
  timeUsedTodaySeconds  Int       @default(0) // accumulated active seconds today (telemetry mirror)
  // The calendar day (YYYY-MM-DD, worker TZ) jobsToday/timeUsedTodaySeconds
  // belong to — lets the worker re-hydrate counters on restart only if still today.
  countersDate          String?

  createdBy String? // super admin user id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events              SocialAccountEvent[]
  jobs                ScrapeJob[]
  proxy               SocialProxy?         @relation("AccountProxy")
  remoteExtensionHost RemoteExtensionHost? @relation("RemoteExtensionHostLane", fields: [remoteExtensionHostId], references: [id], onDelete: SetNull)

  @@unique([platform, laneIndex])
  @@index([platform])
  @@index([status])
  @@index([enabled])
  @@map("social_accounts")
}

// A browser extension installation registered as a remote worker-fb lane host.
// It never persists scraped data itself: Core brokers browser commands between
// worker-fb and this host, and worker-fb returns the normalized scrape result.
model RemoteExtensionHost {
  id               String                    @id @default(cuid())
  installationId   String                    @unique
  label            String
  status           RemoteExtensionHostStatus @default(PENDING)
  pairingTokenHash String?                   @db.Text
  pairingExpiresAt DateTime?
  deviceTokenHash  String?                   @db.Text
  lastHeartbeatAt  DateTime?
  browserConnected Boolean                   @default(false)
  facebookLoggedIn Boolean                   @default(false)
  capabilities     Json?
  extensionVersion String?
  lastError        String?                   @db.Text
  wakeRequestedAt  DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  lane     SocialAccount?      @relation("RemoteExtensionHostLane")
  commands RemoteLaneCommand[]

  @@index([status])
  @@index([lastHeartbeatAt])
  @@map("remote_extension_hosts")
}

model RemoteLaneCommand {
  id           String                  @id
  hostId       String
  host         RemoteExtensionHost     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  laneId       String
  leaseId      String
  action       String
  payload      Json
  result       Json?
  error        String?                 @db.Text
  status       RemoteLaneCommandStatus @default(PENDING)
  issuedAt     DateTime                @default(now())
  dispatchedAt DateTime?
  completedAt  DateTime?
  expiresAt    DateTime

  @@index([hostId, status, issuedAt])
  @@index([laneId, status])
  @@index([leaseId])
  @@map("remote_lane_commands")
}

// Dedicated, platform-scoped proxy inventory for social-media scraping.
// Completely separate from the shared proxy-rotator. One proxy is assigned to at
// most one account (1:1), so every account/lane gets its own dedicated IP.
model SocialProxy {
  id            String         @id @default(cuid())
  platform      ScrapePlatform @default(FACEBOOK)
  host          String
  port          Int
  username      String?
  password      String?        @db.Text
  label         String?
  enabled       Boolean        @default(true)
  status        String         @default("UNKNOWN") // UNKNOWN | HEALTHY | DEAD
  lastCheckedAt DateTime?

  // 1:1 assignment to a social account.
  assignedAccountId String?        @unique
  assignedAccount   SocialAccount? @relation("AccountProxy", fields: [assignedAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, host, port])
  @@index([platform])
  @@index([enabled])
  @@map("social_proxies")
}

model SocialAccountEvent {
  id        String        @id @default(cuid())
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type      String // LOGIN | COOKIE_INVALID | COOLDOWN | ERROR | ENABLED | DISABLED | JOB | PROXY_CHANGED | CHECKPOINT | LOGGED_OUT | RESET | REAP
  message   String?  @db.Text
  // Forensic context for lockout diagnosis: which scrape activity the account was
  // performing when this event fired, and the URL it landed on (e.g. a redirect to
  // .../checkpoint/...). Nullable + additive — pre-existing events keep working.
  operation String? // scrape op in flight: profile_posts | post_comments | post_shares | video_metrics | ...
  url       String?  @db.Text // final/landed URL captured at event time (checkpoint/login-wall redirect)
  detail    Json? // extra structured context (classification, httpStatus, laneIndex, ...)
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, type, createdAt])
  @@map("social_account_events")
}

model TechnicalPanelAiAutomationSetting {
  id            String    @id @default(cuid())
  automationKey String    @unique
  enabled       Boolean   @default(false)
  running       Boolean   @default(false)
  aiProvider    String    @default("falcon")
  aiModel       String    @default("web-grok/grok-expert")
  // "sequential" (one request at a time) | "parallel" (bounded concurrent dispatch)
  dispatchMode  String    @default("sequential")
  concurrency   Int       @default(1)
  message       String?   @db.Text
  startedAt     DateTime?
  stoppedAt     DateTime?
  lastItemId    String?
  processed     Int       @default(0)
  completed     Int       @default(0)
  failed        Int       @default(0)
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([automationKey])
  @@map("technical_panel_ai_automation_settings")
}

model TechnicalPanelAiProviderSetting {
  id              String   @id @default(cuid())
  settingsKey     String   @unique
  provider        String   @default("cortex")
  providerConfigs Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([settingsKey])
  @@map("technical_panel_ai_provider_settings")
}

model BotDetectionSettings {
  id                  String  @id @default(cuid())
  settingsKey         String  @unique @default("default")
  enabled             Boolean @default(true)
  scanIntervalSeconds Int     @default(300)

  // Lookback window — how far back to consider posted-time-populated comments.
  // Null = no time bound (all-time, current default). When set, applies ONLY to
  // postedAt-populated rows; null-postedAt rows are always included regardless
  // (Option A rule — never substitute scrapedAt as a posting-time proxy).
  lookbackWindowHours Int?

  rateBurstWindowSeconds     Int   @default(60)
  rateBurstThreshold         Int   @default(5)
  rateSustainedWindowMinutes Int   @default(10)
  rateSustainedThreshold     Int   @default(20)
  samePostWindowMinutes      Int   @default(60)
  samePostMaxComments        Int   @default(5)
  duplicateSimilarity        Float @default(0.85)
  duplicateMinOccurrences    Int   @default(3)
  crossCampaignMinPerDay     Int   @default(10)

  // Signal weights — tunable from UI, were hardcoded before
  weightBurst         Float @default(0.30)
  weightSustained     Float @default(0.20)
  weightSamePost      Float @default(0.20)
  weightDuplicate     Float @default(0.20)
  weightCrossCampaign Float @default(0.10)

  // Score thresholds — the 3 cutoffs that define CLEAN/SUSPECTED/FLAGGED/CONFIRMED_BOT ranges
  scoreThresholdSuspected   Float @default(0.3)
  scoreThresholdFlagged     Float @default(0.6)
  scoreThresholdAutoConfirm Float @default(0.85)

  // Auto-confirm policy — score >= autoConfirm AND triggered >= minSignals
  autoConfirmEnabled             Boolean @default(true)
  autoConfirmMinTriggeredSignals Int     @default(3)

  // Performance tuning — were hardcoded constants before
  scanCandidateBatchSize  Int @default(200)
  scanAnalysisConcurrency Int @default(20)
  recentCommentFetchCap   Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bot_detection_settings")
}

model Worker {
  id   String @id @default(cuid())
  name String @unique

  // Capabilities
  platforms ScrapePlatform[] // Which platforms this worker can handle

  // Status & Health
  status        WorkerStatus @default(OFFLINE)
  lastHeartbeat DateTime?
  lastJobAt     DateTime? // Last time it processed a job

  // Performance metrics
  jobsCompleted  Int    @default(0)
  jobsFailed     Int    @default(0)
  avgJobDuration Float? // Average job duration in seconds

  // Configuration
  maxConcurrent Int     @default(1) // Max concurrent jobs
  currentLoad   Int     @default(0) // Current active jobs
  version       String? // Worker version for compatibility

  // Connection info
  ipAddress String?
  hostname  String?
  metadata  Json? // Additional worker metadata

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastHeartbeat])
  @@map("workers")
}

model ScrapeResult {
  id    String    @id @default(cuid())
  jobId String
  job   ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Content
  rawContent      String   @db.Text
  url             String?
  title           String?
  author          String?
  summary         String?  @db.Text
  tags            String[] @default([])
  contentLength   Int?     @map("content_length")
  matchedKeywords String[] @default([]) @map("matched_keywords")

  // Date ownership mirrors NewsArticle: AI publication time, worker scrape time.
  publishedAt    DateTime?
  scrapedAt      DateTime?
  rawPublishedAt String? // Raw date string from news worker
  rawScrapedAt   String? // Raw scraped date string from news worker

  // AI Analysis Results
  sentiment Float? // -1 to 1
  embedding Unsupported("vector(1536)")? // pgvector

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  newsArticle    NewsArticle?
  newsHeadline   NewsHeadline?
  entities       ScrapeResultEntity[]
  topics         ScrapeResultTopic[]
  toxicity       Toxicity?
  // legacy FactCheck relation removed; SocialPostFactCheck is the live fact-check store
  keywordMatches ScrapeResultKeyword[]

  @@index([jobId])
  @@index([publishedAt])
  @@index([scrapedAt])
  @@index([tags], type: Gin)
  @@map("scrape_results")
}

// ============================================
// KEYWORD MANAGEMENT MODELS
// ============================================

model KeywordCategory {
  id          String                   @id @default(cuid())
  name        String
  /// Stable machine id for AI/system categories. Survives display-name renames.
  slug        String?
  description String?                  @db.Text
  color       String                   @default("#06b6d4") // Default cyan color
  type        KeywordCategoryType      @default(MANUAL)
  reference   KeywordCategoryReference @default(no_assigned)
  isVisible   Boolean                  @default(true)

  // User relationship
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ordering
  sortOrder       Int     @default(0)
  /// When true, seed/default sort sync must not overwrite sortOrder (user reordered in UI).
  sortOrderLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  keywords                      Keyword[]
  newsArticles                  NewsArticle[]
  trendingIntelligenceSnapshots TrendingCategoryIntelligence[]

  @@unique([userId, name])
  @@unique([userId, slug])
  @@index([userId])
  @@index([slug])
  @@index([sortOrder])
  @@index([type])
  @@index([reference])
  @@index([isVisible])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "keyword_categories_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "keyword_categories_description_trgm_idx")
  @@map("keyword_categories")
}

// ============================================
// TRENDING CATEGORY INTELLIGENCE (AGGREGATE)
// ============================================
// NOTE: This table is intended for KeywordCategory.type = TRENDING only.
// Prisma cannot enforce cross-table enum checks, so enforce this in service layer.
model TrendingCategoryIntelligence {
  id String @id @default(cuid())

  // Category scope (must point to a TRENDING keyword category by application rule)
  keywordCategoryId String?
  keywordCategory   KeywordCategory? @relation(fields: [keywordCategoryId], references: [id], onDelete: Cascade)
  aiKeyword         String?

  // Time window metadata
  windowType  String // e.g. "1h", "6h", "24h", "7d", "custom"
  windowStart DateTime
  windowEnd   DateTime
  generatedAt DateTime @default(now())

  // Coverage and reliability
  articleCount    Int    @default(0)
  sampledCount    Int    @default(0)
  sourceCount     Int    @default(0)
  confidenceScore Float? // 0-1 confidence for this snapshot

  // At-a-glance intelligence payload
  whatHappened    String?  @db.Text // short narrative summary
  whyTrending     String?  @db.Text // why this topic is currently trending
  keyDevelopments String[] @default([]) // timeline-like bullets
  potentialImpact String?  @db.Text

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv        Unsupported("tsvector")?     @map("search_tsv")
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")

  // Structured evidence/analytics
  topEntities        Json? // [{name,type,count}, ...]
  topSources         Json? // [{source,count}, ...]
  topKeywords        Json? // [{keyword,count}, ...]
  trendSignals       Json? // {volumeSpike, velocity, breakout, ...}
  evidenceArticleIds String[] @default([]) // representative supporting article IDs

  // Raw model artifacts and diagnostics
  modelProvider  String? // falcon / cortex / etc.
  modelName      String?
  promptVersion  String?
  generationMeta Json? // token stats, latency, retries, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keywordCategoryId, windowType, windowStart, windowEnd], map: "uniq_trending_intel_window")
  @@index([keywordCategoryId])
  @@index([aiKeyword])
  @@index([windowType])
  @@index([windowStart])
  @@index([windowEnd])
  @@index([generatedAt])
  @@index([confidenceScore])
  @@map("trending_category_intelligence")
}

model Keyword {
  id      String        @id @default(cuid())
  keyword String
  color   String        @default("#06b6d4") // Hex color for visual identification
  status  KeywordStatus @default(ACTIVE)

  // Category relationship
  categoryId String
  category   KeywordCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // User relationship
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  description String?  @db.Text
  aliases     String[] // Alternative terms/variations

  // Tracking metrics
  matchCount  Int       @default(0) // How many times this keyword was matched
  lastMatchAt DateTime? // Last time this keyword was found

  // Configuration
  caseSensitive Boolean @default(false)
  isRegex       Boolean @default(false)
  priority      Int     @default(0) // Higher priority keywords checked first

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campaignKeywords CampaignKeyword[]
  scrapeMatches    ScrapeResultKeyword[]
  articleLinks     NewsArticleKeyword[]

  @@unique([userId, categoryId, keyword])
  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([keyword])
  @@index([keyword(ops: raw("gin_trgm_ops"))], type: Gin, map: "keywords_keyword_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "keywords_description_trgm_idx")
  @@index([aliases], type: Gin, map: "keywords_aliases_gin_idx")
  @@map("keywords")
}

model CampaignKeyword {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  // Campaign-specific settings
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, keywordId])
  @@index([campaignId])
  @@index([keywordId])
  @@map("campaign_keywords")
}

model ScrapeResultKeyword {
  id             String       @id @default(cuid())
  scrapeResultId String
  scrapeResult   ScrapeResult @relation(fields: [scrapeResultId], references: [id], onDelete: Cascade)

  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  // Match details
  matchCount Int      @default(1) // How many times in this content
  positions  Json? // Array of positions where keyword was found
  context    String[] // Surrounding text snippets

  createdAt DateTime @default(now())

  @@unique([scrapeResultId, keywordId])
  @@index([scrapeResultId])
  @@index([keywordId])
  @@map("scrape_result_keywords")
}

