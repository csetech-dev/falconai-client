// ============================================
// AI ANALYSIS SYSTEM (Async Request/Webhook)
// ============================================

enum AIAnalysisType {
  PROFILE
  POST
  NEWS
  FACT_CHECK
  VIDEO
}

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model AIAnalysisRequest {
  id              String            @id @default(cuid())
  
  // Request type
  analysisType    AIAnalysisType
  status          AIAnalysisStatus  @default(PENDING)
  
  // Reference IDs (one of these will be set based on analysisType)
  campaignId      String?           // For PROFILE analysis
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  postId          String?           // For POST analysis
  newsQueryParams Json?             // For NEWS analysis (search params, date range, etc.)
  factCheckContext Json?            // For FACT_CHECK analysis (top sources + trigger metadata)
  
  // External AI integration
  externalRequestId String?         // ID returned by external AI service
  callbackUrl     String?           // Webhook URL for the external AI to call back
  
  // API reference for external AI to fetch data
  dataApiUrl      String?           @db.Text  // The API URL external AI should use to fetch data
  responsePayload Json?             // Stores callback response payload for transient UI consumption
  
  // Error handling
  errorMessage    String?           @db.Text
  retryCount      Int               @default(0)
  maxRetries      Int               @default(3)
  
  // Timing
  requestedAt     DateTime          @default(now())
  processingAt    DateTime?         // When external AI started processing
  completedAt     DateTime?         // When results were received
  expiresAt       DateTime?         // Request expiration
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Inverse: a FACT_CHECK run produces one persisted SocialPostFactCheck row
  factCheckResult SocialPostFactCheck?
  
  @@index([analysisType])
  @@index([status])
  @@index([campaignId])
  @@index([postId])
  @@index([externalRequestId])
  @@map("ai_analysis_requests")
}

/// Persisted fact-check results for social posts. One row per AI run; the most
/// recent run for a post is marked isLatest=true (maintained transactionally).
/// History is preserved so the verdict timeline can be inspected over time.
model SocialPostFactCheck {
  id                  String            @id @default(cuid())
  postId              String
  post                SocialPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  analysisRequestId   String?           @unique
  analysisRequest     AIAnalysisRequest? @relation(fields: [analysisRequestId], references: [id], onDelete: SetNull)
  
  // Verdict + scores
  verdict             String            // true | partially_verified | misleading | unverified | not_fact_checkable
  overallScore        Int               // 0-100
  confidence          Int               // 0-100
  summary             String            @db.Text
  
  // Per-metric scores (columns so dashboards can filter without JSON ops)
  sourceCredibility   Int
  contentConsistency  Int
  factualAccuracy     Int
  biasDetection       Int
  
  // Sources + per-source AI reviews (full evidence chain, replayable)
  articleReviews      Json              // [{ id, originalMatchScore, aiMatchScore, finalMatchScore, verdict, role, reason }, ...]
  sourcesFingerprint  String            // sha1(sorted source IDs) — cache key for "same evidence set"
  sourceCount         Int
  
  // Claim package snapshot (what we asked the AI)
  claimText           String            @db.Text
  claimType           String            // factual_event | policy_statement | quote_or_attribution | opinion_or_reaction | personal_or_greeting
  factCheckable       Boolean

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv           Unsupported("tsvector")? @map("search_tsv")
  contentEmbedding    Unsupported("vector(1024)")? @map("content_embedding")
  
  // History bookkeeping
  isLatest            Boolean           @default(true)
  triggeredBy         String?           // auto | manual_rerun | <x-user-id>
  createdAt           DateTime          @default(now())
  
  @@index([postId, isLatest])
  @@index([postId, createdAt(sort: Desc)])
  @@index([verdict])
  @@map("social_post_fact_checks")
}

model ProfileAIAnalytics {
