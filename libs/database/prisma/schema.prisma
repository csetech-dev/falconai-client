// ──────────────────────────────────────────────────────────────────────────────
// Dynamic Reports System
// Block-based reports with templates, versions, sharing, collaboration, exports.
// ──────────────────────────────────────────────────────────────────────────────

enum ReportStatus {
  DRAFT
  FINAL
  ARCHIVED
}

/// Page orientation honored by the print view (`@page` rule) and the DOCX
/// section properties on export. Defaults to PORTRAIT.
enum ReportPageOrientation {
  PORTRAIT
  LANDSCAPE
}

enum ReportTemplateCategory {
  NEWS
  SOCIAL
  COMBINED
  VIDEO_LIVE
  PROFILE
  CUSTOM
}

enum ReportShareVisibility {
  PUBLIC
  TEAM
}

enum ReportCollaboratorRole {
  EDITOR
  VIEWER
}

enum ReportExportFormat {
  PDF
  DOCX
}

enum ReportExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ReportTemplate {
  id           String                 @id @default(cuid())
  userId       String?
  name         String
  description  String?
  category        ReportTemplateCategory @default(CUSTOM)
  language        String                 @default("en")
  pageOrientation ReportPageOrientation  @default(PORTRAIT)
  pageMarginTopCm    Float               @default(1.0)
  pageMarginRightCm  Float               @default(1.0)
  pageMarginBottomCm Float               @default(1.0)
  pageMarginLeftCm   Float               @default(1.0)
  isSystem        Boolean                @default(false)
  blocks          Json
  thumbnailUrl    String?
  tags            String[]               @default([])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([userId])
  @@index([category])
  @@map("report_templates")
}

model Report {
  id               String       @id @default(cuid())
  userId           String
  templateId       String?
  name             String
  description      String?
  status              ReportStatus          @default(DRAFT)
  blocks              Json
  resolvedSnapshot    Json?
  language            String                @default("en")
  pageOrientation     ReportPageOrientation @default(PORTRAIT)
  pageMarginTopCm     Float                 @default(1.0)
  pageMarginRightCm   Float                 @default(1.0)
  pageMarginBottomCm  Float                 @default(1.0)
  pageMarginLeftCm    Float                 @default(1.0)
  currentVersionId    String?
  /// Persisted report-level date filter (YYYY-MM-DD). Used by data
  /// blocks as the default date range when resolving live data.
  reportDateFrom      String?
  reportDateTo        String?
  publishedAt         DateTime?
  /// Optional cron expression (e.g. "0 8 * * 0"). When set, a BullMQ
  /// repeatable job re-publishes the report on this schedule.
  cronSchedule     String?
  scheduleLastFiredAt DateTime?
  /// Soft-delete timestamp. When set, the report is in the trash bin
  /// and excluded from normal list/get queries. Permanently deleted
  /// via a separate hard-delete endpoint.
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      ReportTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions      ReportVersion[]
  shareLinks    ReportShareLink[]
  collaborators ReportCollaborator[]
  exports       ReportExport[]
  auditEvents   ReportAuditEvent[]

  @@index([userId, status])
  @@index([templateId])
  @@index([deletedAt])
  @@map("reports")
}

model ReportVersion {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  versionNo Int
  blocks    Json
  summary   String?
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation("ReportVersionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([reportId, versionNo])
  @@index([reportId, createdAt])
  @@map("report_versions")
}

model ReportShareLink {
  id           String                @id @default(cuid())
  reportId     String
  token        String                @unique @default(uuid())
  visibility   ReportShareVisibility @default(PUBLIC)
  createdBy    String
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime              @default(now())
  /// bcrypt hash of an optional access password. When set, the share
  /// endpoint requires a matching password in the X-Share-Password header.
  passwordHash String?
  /// Incremented each time the share link is successfully resolved.
  viewCount    Int                   @default(0)
  lastViewedAt DateTime?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_share_links")
}

model ReportCollaborator {
  id        String                 @id @default(cuid())
  reportId  String
  userId    String
  role      ReportCollaboratorRole @default(VIEWER)
  addedBy   String
  createdAt DateTime               @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
  @@map("report_collaborators")
}

model ReportExport {
  id          String             @id @default(cuid())
  reportId    String
  format      ReportExportFormat
  status      ReportExportStatus @default(PENDING)
  requestedBy String
  fileUrl     String?
  errorMsg    String?
  createdAt   DateTime           @default(now())
  finishedAt  DateTime?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, status])
  @@map("report_exports")
}

enum ReportAuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  PUBLISH
  FORK
  RESTORE_VERSION
  EXPORT_PDF
  EXPORT_DOCX
  SHARE_CREATE
  SHARE_REVOKE
  SHARE_VIEW
  COLLAB_ADD
  COLLAB_REMOVE
  COLLAB_ROLE_CHANGE
  SCHEDULE_SET
  SCHEDULE_CLEAR
  SCHEDULE_FIRE
  AI_SUMMARY
}

/// Append-only audit trail for every consequential action against a report.
/// Required for the intel-tool deployment so every read/edit/share/export
/// can be reconstructed after the fact.
model ReportAuditEvent {
  id        String            @id @default(cuid())
  reportId  String
  /// Null for system actions (scheduled publish) or anonymous share views.
  actorId   String?
  action    ReportAuditAction
  /// Free-form structured detail — target user id (for collab), share token,
  /// version no (for restore), export format, etc.
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime          @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("report_audit_events")
}

// ============================================
// REPORT TAXONOMY — user-editable category / topic-group / source-
// group definitions the report-builder consumes. Initially seeded
// from the constants under apps/core-service/src/reports/seed/, but
// mutable from the admin UI so analysts can add categories /
// keywords without a code change.
//
// Naming is deliberately client-neutral:
//   - ReportCategory   → keyword-matched categories with a preset
//                        (e.g. ECONOMY) — used by the Negative-
//                        Coverage Index block as section headers.
//   - ReportTopicGroup → keyword-matched content grouping used by
//                        the Outlet-Grouped Headlines block (the
//                        WING_COMPILATION preset).
//   - ReportSourceGroup → display-only source-origin labels used by
//                        the Propaganda Source Tracker block.
//
// Scope is global today (single-tenant deployment); a userId column
// can be added later as a non-breaking change to enable per-user
// customization.
// ============================================

/// Top-level taxonomy preset that groups Categories together (e.g.
/// ECONOMY, POLITICS). Promoted from a Prisma enum to a table in
/// migration `20260518130000_promote_report_category_preset_to_table`
/// so analysts can add presets (DEFENSE, FOREIGN_AFFAIRS, …) without
/// a code change. Keys are stable identifiers used by block specs
/// (the `negativeCoverage` block stores `preset: "ECONOMY"` etc.);
/// renaming a key would break those blocks until they migrate.
model ReportCategoryPreset {
  id          String           @id @default(cuid())
  key         String           @unique
  labelBn     String
  labelEn     String
  /// Free-form context for analysts maintaining the preset — what it
  /// covers, when to use it. Surfaced in the admin UI.
  description String?
  order       Int              @default(0)
  isSystem    Boolean          @default(false)
  isDisabled  Boolean          @default(false)
  /// Soft-delete timestamp. NULL = active, non-NULL = archived. Reads
  /// from resolvers and block dialogs filter `deletedAt: null`; the
  /// row stays in place so historical reports that reference its key
  /// keep resolving. Admin UI can restore by clearing this field.
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  categories  ReportCategory[]

  @@index([order])
  @@index([deletedAt])
  @@map("report_category_presets")
}

/// Keyword-matched category used by the Negative-Coverage Index
/// block to section articles. One row per (presetId, key) —
/// e.g. (<ECONOMY preset id>, "banking_finance"). `keywords` is a
/// multilingual substring list matched against NewsArticle.title /
/// category / content. `isSystem=true` flags rows originally seeded
/// from code; UI shows a "reset to defaults" affordance that
/// re-upserts these.
model ReportCategory {
  id          String   @id @default(cuid())
  presetId    String
  key         String
  labelBn     String
  labelEn     String
  /// Optional "what this category is for" note — helps avoid drift
  /// between system rows and analyst-added customs when tuning
  /// keywords over time.
  description String?
  keywords    String[] @default([])
  order       Int      @default(0)
  isSystem    Boolean  @default(false)
  isDisabled  Boolean  @default(false)
  /// Soft-delete timestamp — see ReportCategoryPreset.deletedAt.
  /// Cascade-on-delete from the parent preset: soft-deleting a preset
  /// stamps `deletedAt` on every child category in the same
  /// transaction. Restore is per-row (not cascaded) so analysts can
  /// resurrect a preset without un-archiving categories they had
  /// already filtered out manually.
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  preset      ReportCategoryPreset @relation(fields: [presetId], references: [id], onDelete: Restrict)

  @@unique([presetId, key])
  @@index([presetId, order])
  @@index([deletedAt])
  @@map("report_categories")
}

/// Keyword-matched content grouping used by the Outlet-Grouped
/// Headlines block's WING_COMPILATION preset. Matches against
/// NewsArticle fields the same way as ReportCategory keywords.
model ReportTopicGroup {
  id          String   @id @default(cuid())
  key         String   @unique
  labelBn     String
  labelEn     String
  description String?
  keywords    String[] @default([])
  order       Int      @default(0)
  isSystem    Boolean  @default(false)
  isDisabled  Boolean  @default(false)
  /// Soft-delete timestamp — see ReportCategoryPreset.deletedAt.
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([deletedAt])
  @@map("report_topic_groups")
}

/// Topic taxonomy used to classify notifications into the desk's fixed
/// Bengali reporting categories (দৈনন্দিন রিপোর্টের বিষয়বস্তু). Admin-editable
/// and DB-seeded; `keywords` drive the keyword-first classification pass,
/// with an AI fallback on no-hit/tie. Mirrors ReportTopicGroup.
model NotificationCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  labelBn     String
  labelEn     String
  description String?
  keywords    String[] @default([])
  order       Int      @default(0)
  isSystem    Boolean  @default(false)
  isDisabled  Boolean  @default(false)
  /// Soft-delete timestamp — see ReportCategoryPreset.deletedAt.
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([deletedAt])
  @@map("notification_categories")
}

/// Display-only source-origin group used by the Propaganda Source
/// Tracker block. Note: matching logic (the Prisma WHERE for each
/// group) is hardcoded in the resolver for the seeded keys
/// (INDIAN_FB_YT / BD_FB / BLOGGERS / TWITTER / TELEGRAM). User-added
/// rows render in the UI but won't match posts until matching rules
/// are introduced — the admin form flags this for non-seeded keys.
model ReportSourceGroup {
  id          String   @id @default(cuid())
  key         String   @unique
  labelBn     String
  labelEn     String
  description String?
  order       Int      @default(0)
  isSystem    Boolean  @default(false)
  isDisabled  Boolean  @default(false)
  /// Soft-delete timestamp — see ReportCategoryPreset.deletedAt.
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([deletedAt])
  @@map("report_source_groups")
}

// ============================================
// WILD SEARCH BOOKMARKS
// ============================================

/// A saved / favourited result from the Profile Wild Search panel.
/// One row per bookmarked mention, scoped to the campaign (profile).
model WildSearchBookmark {
  id              String    @id @default(cuid())
  campaignId      String    @map("campaign_id")
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// The headline / title of the saved result.
  title           String    @db.Text

  /// Optional full text snippet or body.
  content         String?   @db.Text

  /// Direct URL to the source article / post.
  url             String?   @db.Text @map("url")

  /// Thumbnail / preview image URL (if any).
  imageUrl        String?   @db.Text @map("image_url")

  /// Human-readable source name (e.g. "The Daily Star").
  sourceName      String?   @map("source_name")

  /// Published-at text as returned by the scraper (may be relative like "2h ago").
  publishedAtText String?   @map("published_at_text")

  /// ISO timestamp when the item was scraped.
  scrapedAt       DateTime? @map("scraped_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([campaignId], map: "wsb_campaign_id_idx")
  @@index([createdAt], map: "wsb_created_at_idx")
  @@index([url], map: "wsb_url_idx")
  @@unique([campaignId, url, title], map: "wsb_campaign_url_title_key")
  @@map("wild_search_bookmarks")
}

// ============================================
// REPORT BOOKMARKS (Report Cart)
// ============================================

/// A bookmarked news article or social post collected for report generation.
/// One row per bookmarked item, scoped to the user who bookmarked it.
model ReportBookmark {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The original item ID (SocialPost.id or NewsArticle.id).
  itemId          String   @map("item_id")

  /// 'news' or 'social'.
  itemType        String   @map("item_type")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, itemId], map: "rb_user_item_key")
  @@index([userId], map: "rb_user_id_idx")
  @@index([createdAt], map: "rb_created_at_idx")
  @@map("report_bookmarks")
}

/// Live stream recording channel — stores a YouTube live URL and its topics.
/// Each topic has its own schedule (start/end/chunk) and produces a separate
/// video in the `videos` table after recording completes.
model LiveRecordChannel {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topics LiveRecordTopic[]

  @@map("live_record_channels")
}

/// One topic within a live recording channel. Each topic is recorded as a
/// separate segment and saved as its own row in the `videos` table.
model LiveRecordTopic {
  id            String   @id @default(cuid())
  channelId     String   @map("channel_id")
  channel       LiveRecordChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  topicName     String   @map("topic_name")
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  chunkSeconds  Int      @default(30) @map("chunk_seconds")
  /// Schedule type: ONE_TIME | RECURRING_DAILY
  scheduleType  String   @default("ONE_TIME") @map("schedule_type")
  /// Date string (YYYY-MM-DD) of the last recording start for recurring topics
  lastRunDate   String?  @map("last_run_date")
  /// Recording status: PENDING | RECORDING | COMPLETED | FAILED
  status        String   @default("PENDING")
  /// Worker-video job ID for polling progress
  jobId         String?  @map("job_id")
  /// Progress percent 0-100
  percent       Int      @default(0)
  /// Status message from the worker
  message       String?
  /// The video row created when recording completes
  videoId       String?  @map("video_id")
  video         Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([channelId], map: "lrt_channel_id_idx")
  @@index([status], map: "lrt_status_idx")
  @@map("live_record_topics")
}
