  score    Float        @default(0)

  // Profile / Campaign context
  profileId String? // campaignId of the profile that owns this post
  platform  ScrapePlatform? // e.g. FACEBOOK, TWITTER, LINKEDIN, TELEGRAM

  // Cached engagement metrics (snapshot at compute time)
  likesCount     Int   @default(0)
