model VideoSource {
  id        String   @id @default(cuid())
  name      String
  link      String
  logoUrl   String?
  type      String   @default("Other")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos Video[]

  @@unique([link])
  @@index([name])
  @@index([type])
  @@map("video_sources")
}

/// DEPRECATED — legacy per-ScrapeResult extraction. Dead since introduction:
/// the only reference in the repo is a `deleteMany`. Superseded by
/// `EntityMention`, because this table can only ever describe content that
/// arrived through `ScrapeResult`, which reaches news articles and headlines
/// and **never** social posts or comments. Kept (not dropped) so no existing
/// row is destroyed; do not write to it.
model ScrapeResultEntity {
  id       String       @id @default(cuid())
  resultId String
  result   ScrapeResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  text       String // "Joe Biden", "Microsoft"
  type       EntityType
  confidence Float
  startPos   Int?
  endPos     Int?

  createdAt DateTime @default(now())

  @@index([resultId])
  @@index([type])
  @@index([text])
  @@map("entities")
}

/// DEPRECATED — see ScrapeResultEntity. Superseded by `VideoTopic` for video
/// and by narrative threading (P5-5) for everything else.
model ScrapeResultTopic {
  id       String       @id @default(cuid())
  resultId String
  result   ScrapeResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  label    String // "Climate Change", "AI Ethics"
  score    Float // 0-1 relevance
  keywords String[] // Associated keywords

  createdAt DateTime @default(now())

  @@index([resultId])
  @@index([label])
  @@map("topics")
}

model Toxicity {
  id       String       @id @default(cuid())
  resultId String       @unique
  result   ScrapeResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  overall          Float // 0-1
  hate             Float
  threat           Float
  profanity        Float
  identityAttack   Float
  sexuallyExplicit Float?

  createdAt DateTime @default(now())

  @@map("toxicity")
}

// Legacy FactCheck model removed 2026-05-23. It was tied to ScrapeResult (news scrape
// pipeline) and never populated. The live fact-check store is SocialPostFactCheck.

model TrendSnapshot {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  period    TrendPeriod
  timestamp DateTime

  // Aggregated metrics
  articleCount Int
  avgSentiment Float
  topEntities  Json // [{text, type, frequency}]
  topTopics    Json // [{label, frequency, avgScore}]
  avgToxicity  Float?

  // Trend indicators
  sentimentShift Float? // vs previous period
  emergingTopics Json? // New topics with growth rate

  createdAt DateTime @default(now())

  @@unique([campaignId, period, timestamp])
  @@index([campaignId, period, timestamp])
  @@map("trend_snapshots")
}

// ============================================
// SOCIAL SCRAPING MODELS (now using Campaign)
// ============================================

model SocialPost {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Post identifiers
  platformPostId String // Original post ID from platform
  url            String?

  // Content
  caption       String?  @db.Text
  photoUrls     String[]
  photoOcrTexts String[] // OCR extracted text from photos
  videoUrl      String?

  // Timing
  postedAt  DateTime?
  scrapedAt DateTime  @default(now())

  // Engagement counts (for quick access)
  commentCount   Int     @default(0)
  shareCount     Int     @default(0)
  totalReactions Int     @default(0)
  saves          Int     @default(0)
  impressions    Int     @default(0)
  reach          Int     @default(0)
  // Video view count (nullable): only set for video posts (postType VIDEO /
  // MIXED_VIDEO). The FB timeline scrape provides this for free. Used as the
  // baseline seed when creating the video snapshot (video_snapshots), and to
  // display current views in the UI. Null for non-video posts.
  videoViewCount BigInt? @map("video_view_count")

  // Analysis
  sentiment        Float? // -1 to 1
  viralPotential   Float? // 0 to 1
  autoScrape       Boolean    @default(false)
  aiAnalysisStatus String?    @default("PENDING") // Legacy column preserved for existing data
  status           PostStatus @default(NOT_ANALYZED)

  // === Viral monitoring lifecycle (added for SocialPostSnapshot pipeline) ===
  // These fields are independent of the existing `status` AI moderation enum.
  // Existing AI moderation behavior (NOT_ANALYZED -> GOOD/BAD on `status`) is preserved.
  postType                 String? // TEXT | PHOTO | PHOTO_TEXT | VIDEO | MIXED_VIDEO
  hasVideo                 Boolean   @default(false)
  viralMonitoringStatus    String? // BASELINE_CREATED | FILTERED_UNSUPPORTED | AI_PENDING | BAD_RETAINED | FOLLOWUP_SCHEDULED | NOT_VIRAL | VIRAL_CANDIDATE | AUTO_SCHEDULED | FULL_MONITORING
  isViralCandidate         Boolean   @default(false)
  isViral                  Boolean   @default(false)
  isAutoScheduled          Boolean   @default(false)
  scheduledIntervalMinutes Int?
  lastSnapshotAt           DateTime?
  nextSnapshotAt           DateTime?
  badPostExpiresAt         DateTime?
  // === END viral monitoring lifecycle ===

  // Platform availability. Flips to UNAVAILABLE when the post is detected as
  // deleted / made private / audience-changed on the platform (e.g. Facebook's
  // "This content isn't available right now" interstitial). Default AVAILABLE.
  // Used to stop wasting snapshot scrapes on dead posts.
  availability  String    @default("AVAILABLE") // AVAILABLE | UNAVAILABLE
  unavailableAt DateTime?

  // AI Hybrid Search (added by migration 002_ai_search)
  /// Dominant script of the content, from libs/bangla-text `detectScript`:
  /// "bangla" | "latin" | "mixed" | "other". Reliable — it is a codepoint test.
  script           String?
  /// Best-effort content language: "bn" | "en" | "mixed".
  /// CAVEAT: derived from script, so Banglish (Bangla written in Latin script)
  /// is currently filed as "en". Fixing that needs the romanization key (P2-7),
  /// not a better heuristic here.
  language         String?
  searchTsv        Unsupported("tsvector")?     @map("search_tsv") // Full-text search vector
  captionEmbedding Unsupported("vector(1024)")? @map("caption_embedding") // BGE-M3 semantic embedding

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  comments            PostComment[]
  shares              PostShare[]
  reactions           PostReaction[]
  reactionSummary     PostReactionSummary[]
  scrapeJobs          ScrapeJob[]
  postAIAnalysis      PostAIAnalysis[]
  socialPostSnapshots SocialPostSnapshot[]
  factChecks          SocialPostFactCheck[]

  groupPostCache GroupPostCache[]
  videoSnapshots VideoSnapshot[]

  @@unique([campaignId, platformPostId])
  @@index([campaignId])
  @@index([campaignId, postedAt])
  @@index([postedAt])
  @@index([scrapedAt])
  @@index([viralMonitoringStatus])
  @@index([isViralCandidate])
  @@map("social_posts")
}

model PostComment {
  id              String     @id @default(cuid())
  postId          String
  post            SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  // NOTE: `campaignId` is the COMMENT AUTHOR's monitored profile (resolved by
  // resolveCommentAuthorCampaign at ingest) — it is NOT the profile that owns
  // the post. Use `ownerCampaignId` for "all comments on profile X".
  campaignId      String?
  campaign        Campaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Denormalized copy of post.campaignId — the profile whose post this comment
  // sits under. Exists so profile-wide comment streams (external sync API) are
  // a single indexed range scan instead of a join through social_post.
  // Populated at ingest; see scripts/backfill-comment-owner-campaign.sql for
  // existing rows.
  ownerCampaignId String?    @map("owner_campaign_id")

  // Comment identifiers
  platformCommentId String? // Original comment ID from platform

  // Author info
  authorUsername  String
  authorUrl       String?
  authorAvatarUrl String?
  commentUrl      String?

  // Content
  text String @db.Text

  // Analysis
  sentiment Float? // -1 to 1
  category  CommentCategory @default(NEUTRAL)

  // Engagement
  likes      Int @default(0)
  replyCount Int @default(0)

  // Filtering
  isRelevant     Boolean @default(true) // For >200 relevant comments filtering
  relevanceScore Float? // 0 to 1, for ranking

  // Timing
  postedAt  DateTime?
  scrapedAt DateTime  @default(now())

  // Nested replies (self-referencing)
  parentId  String?
  parent    PostComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   PostComment[]     @relation("CommentReplies")
  feedbacks ProfileFeedback[]

  createdAt DateTime @default(now())

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv     Unsupported("tsvector")?     @map("search_tsv")
  /// Dominant script of the content, from libs/bangla-text `detectScript`:
  /// "bangla" | "latin" | "mixed" | "other". Reliable — it is a codepoint test.
  script        String?
  /// Best-effort content language: "bn" | "en" | "mixed".
  /// CAVEAT: derived from script, so Banglish (Bangla written in Latin script)
  /// is currently filed as "en". Fixing that needs the romanization key (P2-7),
  /// not a better heuristic here.
  language      String?
  textEmbedding Unsupported("vector(1024)")? @map("text_embedding")

  @@unique([postId, platformCommentId])
  @@index([postId])
  @@index([campaignId])
  @@index([parentId])
  @@index([isRelevant])
  @@index([postedAt])
  @@index([campaignId, postedAt])
  // Per-post drilldown keyset: ORDER BY postedAt, id within one post.
  @@index([postId, postedAt, id])
  // Profile-wide comment streams. scrapedAt is the incremental-sync key (never
  // null); postedAt is the chronological one.
  @@index([ownerCampaignId, scrapedAt])
  // Post-scoped external comment stream (sortBy=scrapedAt). Created in
  // production via sandbox/sql/core-index-post-comments-stream.sql
  // (CONCURRENTLY); declared here so `db push` does not drop it.
  @@index([postId, scrapedAt])
  @@index([ownerCampaignId, postedAt])
  @@map("post_comments")
}

model PostShare {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Sharer info
  sharerUsername  String
  sharerUrl       String?
  sharerAvatarUrl String?

  // Optional link to tracked campaign if sharer is being monitored
  sharerCampaignId String?
  sharerCampaign   Campaign? @relation("SharerProfile", fields: [sharerCampaignId], references: [id], onDelete: SetNull)

  // Share details
  shareText String?           @db.Text // Any text added when sharing
  sharedAt  DateTime?
  scrapedAt DateTime          @default(now())
  feedbacks ProfileFeedback[]

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([sharerCampaignId])
  @@index([sharedAt])
  // Per-post drilldown keyset: ORDER BY sharedAt, id within one post.
  @@index([postId, sharedAt, id])
  @@map("post_shares")
}

model PostReaction {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Reaction info
  reactionType ReactionType

  // Reactor info
  reactorUsername  String
  reactorUrl       String?
  reactorAvatarUrl String?

  // Optional link to tracked campaign if reactor is being monitored
  reactorCampaignId String?
  reactorCampaign   Campaign? @relation("ReactorProfile", fields: [reactorCampaignId], references: [id], onDelete: SetNull)

  // Timing
  reactedAt DateTime?
  scrapedAt DateTime  @default(now())

  createdAt DateTime @default(now())

  @@unique([postId, reactorUsername, reactionType])
  @@index([postId])
  @@index([reactionType])
  @@index([reactorCampaignId])
  @@map("post_reactions")
}

model PostReactionSummary {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  reactionType ReactionType
  count        Int          @default(0)

  updatedAt DateTime @updatedAt

  @@unique([postId, reactionType])
  @@index([postId])
  @@map("post_reaction_summaries")
}

// ============================================
// SOCIAL POST SNAPSHOT (engagement velocity / viral monitoring)
// ============================================
// Snapshots store point-in-time engagement metrics for a SocialPost.
// Snapshot rank=1 (BASELINE) is created right after the existing post save
// flow succeeds; later ranks are created by lightweight metrics refresh jobs.
// This model is additive only and does not replace any existing table.
model SocialPostSnapshot {
  id           String     @id @default(cuid())
  socialPostId String
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  rank  Int // 1, 2, 3 ...
  stage String // BASELINE | FOLLOWUP_1 | FOLLOWUP_2 | FOLLOWUP_3 | SCHEDULED

  // Absolute counts at snapshot time
  reactionCount   Int   @default(0)
  commentCount    Int   @default(0)
  shareCount      Int   @default(0)
  reactionSummary Json? // Optional reaction-type breakdown (e.g. { LIKE: 100, LOVE: 12, ... })

  engagementRate Float @default(0)

  // Comparison fields (null on rank=1)
  previousSnapshotId String?
  reactionDelta      Int?
  commentDelta       Int?
  shareDelta         Int?
  timeDiffMinutes    Float?
  reactionPerMinute  Float?
  commentPerMinute   Float?
  sharePerMinute     Float?

  // Decision output
  viralScore       Float?
  isViralCandidate Boolean @default(false)

  // Timing
  scrapedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([socialPostId, rank])
  @@index([socialPostId])
  @@index([scrapedAt])
  @@index([isViralCandidate])
  @@map("social_post_snapshots")
}

