model Video {
  id                String               @id @default(cuid())
  kind              VideoKind            @default(GENERAL)
  platform          ScrapePlatform       @default(YOUTUBE)
  externalVideoId   String?              @map("external_video_id")
  url               String?
  title             String
  channelId         String               @map("channel_id")
  channelTitle      String?              @map("channel_title")
  channelLogoUrl    String?              @map("channel_logo_url")
  thumbnailUrl      String?              @map("thumbnail_url")
  durationSeconds   Int?                 @map("duration_seconds")
  publishedAt       DateTime?            @map("published_at")
  viewCount         BigInt               @default(0) @map("view_count")
  likeCount         BigInt               @default(0) @map("like_count")
  commentCount      BigInt               @default(0) @map("comment_count")
  summary           String?              @db.Text
  matchedKeywordIds String[]             @default([]) @map("matched_keyword_ids")
  analysisStatus    VideoAnalysisStatus  @default(NOT_SENT) @map("analysis_status")
  /// Overall video sentiment derived from segment majority (POSITIVE/NEUTRAL/NEGATIVE/MIXED).
  sentimentLabel    String?              @map("sentiment_label")
  ingestionMethod   VideoIngestionMethod @default(CAMPAIGN_SCRAPE) @map("ingestion_method")
  storageUrl        String?              @map("storage_url")
  campaignId        String?              @map("campaign_id")
  campaign          Campaign?            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceId          String?              @map("source_id")
  source            VideoSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  scrapedAt         DateTime             @default(now()) @map("scraped_at")
  analyzedAt        DateTime?            @map("analyzed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv        Unsupported("tsvector")?     @map("search_tsv")
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")

  // ── Video viral-monitoring lifecycle (YouTube videos live here, not in
  // social_post). Mirrors the SocialPost viral fields so the video snapshot
  // pipeline can drive baseline → follow-up → recurring auto-schedule → stop /
  // bad-retain. FB videos use social_post's own fields instead. All nullable /
  // defaulted so existing rows are unaffected. ──
  viralMonitoringStatus    String?   @map("viral_monitoring_status") // VIDEO_MONITORING | VIDEO_FOLLOWUP_SCHEDULED | VIDEO_AUTO_SCHEDULED | VIDEO_FULL_MONITORING | VIDEO_NOT_VIRAL | VIDEO_BAD_RETAINED
  isViralCandidate         Boolean   @default(false) @map("is_viral_candidate")
  isAutoScheduled          Boolean   @default(false) @map("is_auto_scheduled")
  scheduledIntervalMinutes Int?      @map("scheduled_interval_minutes")
  lastSnapshotAt           DateTime? @map("last_snapshot_at")
  nextSnapshotAt           DateTime? @map("next_snapshot_at")
  badVideoExpiresAt        DateTime? @map("bad_video_expires_at")

  aiJobs           VideoAiJob[]
  speakers         VideoSpeaker[]
  segments         VideoSegment[]
  topics           VideoTopic[]
  liveRecordTopics LiveRecordTopic[]
  snapshots        VideoSnapshot[]
  scrapeJobs       ScrapeJob[]

  @@unique([campaignId, externalVideoId], map: "yt_campaign_video_unique")
  @@index([campaignId], map: "yt_campaign_id_idx")
  @@index([channelId], map: "yt_channel_id_idx")
  @@index([publishedAt], map: "yt_published_at_idx")
  @@index([sourceId], map: "yt_source_id_idx")
  @@index([platform], map: "video_platform_idx")
  @@index([kind], map: "video_kind_idx")
  @@index([analysisStatus], map: "video_analysis_status_idx")
  @@index([ingestionMethod], map: "video_ingestion_method_idx")
  @@index([sentimentLabel], map: "video_sentiment_label_idx")
  @@map("videos")
}

// ============================================
// VIDEO SNAPSHOTS (engagement time-series)
// ============================================
// Time-series engagement history for a video, mirroring social_post_snapshots
// but widened to cover BOTH Facebook and YouTube video metrics.
//
// All three owning references are NULLABLE by design so a snapshot can attach
// to whatever context it was captured in:
//   - campaignId   : campaign-scraped video
//   - socialPostId : a Facebook video that lives in social_post
//   - videoId      : a row in the videos table (YouTube, or a FB video added
//                    straight into Video Intel)
// A standalone "single video" (e.g. a YouTube link with no campaign) can be
// stored with only videoId set (or even none, keyed purely by platform+
// externalVideoId), which keeps the pipeline flexible.
model VideoSnapshot {
  id String @id @default(cuid())

  // Flexible ownership — any combination may be null.
  campaignId   String?     @map("campaign_id")
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  socialPostId String?     @map("social_post_id")
  socialPost   SocialPost? @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  videoId      String?     @map("video_id")
  video        Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // Video identity (lets a snapshot exist without any FK — a lone single video)
  platform        ScrapePlatform @default(YOUTUBE)
  externalVideoId String?        @map("external_video_id")
  sourceUrl       String?        @map("source_url")

  rank  Int // 1, 2, 3 ...
  stage String @default("BASELINE") // BASELINE | FOLLOWUP_1 | FOLLOWUP_2 | ...

  // ── Absolute counts at snapshot time (superset of both platforms) ──
  viewCount               BigInt  @default(0) @map("view_count") // YT viewCount / FB videoViewCount (unique viewers)
  playCount               BigInt? @map("play_count") // FB total plays; null for YT
  likeCount               BigInt  @default(0) @map("like_count") // YT likes / FB total reactions
  likeCountRyd            BigInt? @map("like_count_ryd") // YT returnyoutubedislike like estimate
  dislikeCount            BigInt? @map("dislike_count") // YT only
  commentCount            BigInt  @default(0) @map("comment_count")
  shareCount              BigInt? @map("share_count") // FB (rounded); null for YT
  reactionSummary         Json?   @map("reaction_summary") // FB reaction-type breakdown; null for YT
  likeCountIsApproximate  Boolean @default(false) @map("like_count_is_approximate")
  shareCountIsApproximate Boolean @default(false) @map("share_count_is_approximate")

  engagementRate Float @default(0) @map("engagement_rate")

  // ── Comparison fields (null on rank=1) ──
  previousSnapshotId String? @map("previous_snapshot_id")
  viewDelta          BigInt? @map("view_delta")
  likeDelta          BigInt? @map("like_delta")
  commentDelta       BigInt? @map("comment_delta")
  shareDelta         BigInt? @map("share_delta")
  timeDiffMinutes    Float?  @map("time_diff_minutes")
  viewPerMinute      Float?  @map("view_per_minute")
  likePerMinute      Float?  @map("like_per_minute") // maps to reactionPerMinute in the post pipeline
  commentPerMinute   Float?  @map("comment_per_minute")
  sharePerMinute     Float?  @map("share_per_minute") // highest-weighted term (x4) in velocity score; FB only

  // ── Decision output ──
  viralScore       Float?  @map("viral_score")
  isViralCandidate Boolean @default(false) @map("is_viral_candidate")

  // ── Timing ──
  scrapedAt DateTime @map("scraped_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([socialPostId])
  @@index([videoId])
  @@index([platform, externalVideoId])
  @@index([scrapedAt])
  @@index([isViralCandidate])
  @@map("video_snapshots")
}

model VideoTopic {
  id           String @id @default(cuid())
  videoId      String @map("video_id")
  video        Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  label        String
  mentionCount Int    @default(0) @map("mention_count")
  sortOrder    Int    @default(0) @map("sort_order")

  /// First time this topic was seen for this video, preserved across
  /// re-analysis. Re-analysis used to delete and recreate every topic, so a
  /// topic's id churned and its age was unrecoverable — which made "when did
  /// this topic first appear" unanswerable and broke any external reference to
  /// a topic id. See VideoTopicEvidenceService.rebuildForVideo.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  evidence VideoTopicEvidence[]

  @@unique([videoId, label])
  @@index([videoId])
  @@map("video_topics")
}

model VideoTopicEvidence {
  id           String       @id @default(cuid())
  topicId      String       @map("topic_id")
  topic        VideoTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  segmentId    String       @map("segment_id")
  segment      VideoSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  mentionCount Int          @default(1) @map("mention_count")

  @@unique([topicId, segmentId])
  @@index([topicId])
  @@index([segmentId])
  @@map("video_topic_evidence")
}

model VideoAiJob {
  id              String           @id @default(cuid())
  videoId         String           @map("video_id")
  video           Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status          VideoAiJobStatus @default(QUEUED)
  externalJobId   String?          @unique @map("external_job_id")
  errorMessage    String?          @map("error_message") @db.Text
  currentStep     String?          @map("current_step")
  progressPercent Int?             @map("progress_percent")
  requestedAt     DateTime         @default(now()) @map("requested_at")
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")

  @@index([videoId, status])
  @@map("video_ai_jobs")
}

model VideoSpeaker {
  id                 String    @id @default(cuid())
  videoId            String    @map("video_id")
  video              Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  speakerKey         String    @map("speaker_key")
  label              String
  summary            String?   @db.Text
  segmentCount       Int       @default(0) @map("segment_count")
  verifiedAt         DateTime? @map("verified_at")
  /// Who confirmed the identity. `verifiedAt`/`verifiedName` recorded that a
  /// human overrode the model's `label` but never which human — and this is the
  /// only genuinely diffable AI-vs-human pair in the schema, so it is the most
  /// valuable identity label the system produces. An identity assertion in an
  /// OSINT product needs a name against it. Not a hard FK, matching the other
  /// reviewer columns.
  verifiedBy         String?   @map("verified_by")
  verifiedName       String?   @map("verified_name")
  organization       String?
  photoUrl           String?   @map("photo_url")
  identityCampaignId String?   @map("identity_campaign_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  images   VideoSpeakerImage[]
  segments VideoSegment[]

  @@unique([videoId, speakerKey])
  @@index([videoId])
  @@index([identityCampaignId])
  @@map("video_speakers")
}

model VideoSpeakerImage {
  id          String       @id @default(cuid())
  speakerId   String       @map("speaker_id")
  speaker     VideoSpeaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  imageUrl    String       @map("image_url")
  timestampMs Int?         @map("timestamp_ms")
  sortOrder   Int          @default(0) @map("sort_order")

  @@index([speakerId, sortOrder])
  @@map("video_speaker_images")
}

model VideoSegment {
  id              String           @id @default(cuid())
  videoId         String           @map("video_id")
  video           Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  segmentIndex    Int              @map("segment_index")
  startMs         Int              @map("start_ms")
  endMs           Int              @map("end_ms")
  text            String           @db.Text
  sentiment       SegmentSentiment
  speakerId       String?          @map("speaker_id")
  speaker         VideoSpeaker?    @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  isRedFlag       Boolean          @default(false) @map("is_red_flag")
  redFlagSeverity RedFlagSeverity? @map("red_flag_severity")
  redFlagReason   String?          @map("red_flag_reason") @db.Text

  // Speaker overlap detection
  isOverlapped    Boolean @default(false) @map("is_overlapped")
  overlapSpeakers Json    @default("[]") @map("overlap_speakers")
  overlapRatio    Float   @default(0.0) @map("overlap_ratio")

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv     Unsupported("tsvector")?     @map("search_tsv")
  textEmbedding Unsupported("vector(1024)")? @map("text_embedding")

  topicEvidence VideoTopicEvidence[]

  @@unique([videoId, segmentIndex])
  @@index([videoId, startMs])
  @@index([speakerId])
  @@index([videoId, isRedFlag])
  @@map("video_segments")
}

// ──────────────────────────────────────────────────────────────────────────────
