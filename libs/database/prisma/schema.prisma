  VIEWER
}

enum ReportExportFormat {
  PDF
  DOCX
}

enum ReportExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ReportTemplate {
  id                 String                 @id @default(cuid())
  userId             String?
  name               String
  description        String?
  category           ReportTemplateCategory @default(CUSTOM)
  language           String                 @default("en")
  pageOrientation    ReportPageOrientation  @default(PORTRAIT)
  pageMarginTopCm    Float                  @default(1.0)
  pageMarginRightCm  Float                  @default(1.0)
  pageMarginBottomCm Float                  @default(1.0)
  pageMarginLeftCm   Float                  @default(1.0)
  isSystem           Boolean                @default(false)
  blocks             Json
  thumbnailUrl       String?
  tags               String[]               @default([])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([userId])
  @@index([category])
  @@map("report_templates")
}

model Report {
  id                  String                @id @default(cuid())
  userId              String
  templateId          String?
  name                String
  description         String?
  status              ReportStatus          @default(DRAFT)
  blocks              Json
  resolvedSnapshot    Json?
  language            String                @default("en")
  pageOrientation     ReportPageOrientation @default(PORTRAIT)
  pageMarginTopCm     Float                 @default(1.0)
  pageMarginRightCm   Float                 @default(1.0)
  pageMarginBottomCm  Float                 @default(1.0)
  pageMarginLeftCm    Float                 @default(1.0)
  currentVersionId    String?
  /// Persisted report-level date filter (YYYY-MM-DD). Used by data
  /// blocks as the default date range when resolving live data.
  reportDateFrom      String?
  reportDateTo        String?
  publishedAt         DateTime?
  /// Optional cron expression (e.g. "0 8 * * 0"). When set, a BullMQ
  /// repeatable job re-publishes the report on this schedule.
  cronSchedule        String?
  scheduleLastFiredAt DateTime?
  /// Soft-delete timestamp. When set, the report is in the trash bin
  /// and excluded from normal list/get queries. Permanently deleted
  /// via a separate hard-delete endpoint.
  deletedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      ReportTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions      ReportVersion[]
  shareLinks    ReportShareLink[]
  collaborators ReportCollaborator[]
  exports       ReportExport[]
  auditEvents   ReportAuditEvent[]

  @@index([userId, status])
  @@index([templateId])
  @@index([deletedAt])
  @@map("reports")
}

model ReportVersion {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  versionNo Int
  blocks    Json
  summary   String?
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation("ReportVersionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([reportId, versionNo])
  @@index([reportId, createdAt])
  @@map("report_versions")
}

model ReportShareLink {
  id           String                @id @default(cuid())
  reportId     String
  token        String                @unique @default(uuid())
  visibility   ReportShareVisibility @default(PUBLIC)
  createdBy    String
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime              @default(now())
  /// bcrypt hash of an optional access password. When set, the share
  /// endpoint requires a matching password in the X-Share-Password header.
  passwordHash String?
  /// Incremented each time the share link is successfully resolved.
  viewCount    Int                   @default(0)
  lastViewedAt DateTime?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_share_links")
}

model ReportCollaborator {
  id        String                 @id @default(cuid())
  reportId  String
  userId    String
  role      ReportCollaboratorRole @default(VIEWER)
  addedBy   String
  createdAt DateTime               @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
  @@map("report_collaborators")
}

model ReportExport {
  id          String             @id @default(cuid())
  reportId    String
  format      ReportExportFormat
  status      ReportExportStatus @default(PENDING)
  requestedBy String
  fileUrl     String?
  errorMsg    String?
  createdAt   DateTime           @default(now())
  finishedAt  DateTime?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, status])
  @@map("report_exports")
}

enum ReportAuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  PUBLISH
  FORK
  RESTORE_VERSION
  EXPORT_PDF
  EXPORT_DOCX
  SHARE_CREATE
  SHARE_REVOKE
  SHARE_VIEW
  COLLAB_ADD
  COLLAB_REMOVE
  COLLAB_ROLE_CHANGE
  SCHEDULE_SET
  SCHEDULE_CLEAR
  SCHEDULE_FIRE
  AI_SUMMARY
}

/// Append-only audit trail for every consequential action against a report.
/// Required for the intel-tool deployment so every read/edit/share/export
/// can be reconstructed after the fact.
model ReportAuditEvent {
  id        String            @id @default(cuid())
  reportId  String
  /// Null for system actions (scheduled publish) or anonymous share views.
  actorId   String?
  action    ReportAuditAction
  /// Free-form structured detail — target user id (for collab), share token,
  /// version no (for restore), export format, etc.
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime          @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("report_audit_events")
}

// ============================================
// USER ACTION AUDIT — system-wide, append-only trail of consequential
// user actions (create / update / delete + sensitive reads) across every
// core-service module. Populated by the @Audit() decorator + global
// AuditInterceptor. Deliberately generic (resource + resourceId) rather
// than per-feature, and denormalizes actorEmail so the trail survives
// user deletion.
// ============================================

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXECUTE // non-CRUD side-effecting action (trigger job, rotate key, run sync…)
  LOGIN
  LOGOUT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model UserAuditEvent {
  id String @id @default(cuid())

  /// Null for anonymous / unauthenticated actions. Not a hard FK on purpose:
  /// audit rows must outlive the user they reference.
  actorId    String?
  /// Snapshot of the actor's email at action time (survives user deletion).
  actorEmail String?

  action     AuditAction
  outcome    AuditOutcome @default(SUCCESS)
  /// Logical resource type, e.g. "campaign", "social-account", "permission".
  resource   String
  /// Affected entity id when known (from route param, body, or handler result).
  resourceId String?

  /// Free-form structured detail — changed fields, target user, job id, etc.
  /// Sensitive values (passwords, tokens, keys) must be redacted before write.
  metadata Json?

  method    String? // HTTP verb
  path      String? // request path (query stripped)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("user_audit_events")
}

// ============================================
// AI FEEDBACK CAPTURE
//
// Analysts correct AI-written analysis fields through the "refine with
// AI, then save" loop (AiAnalysisRefineService + the
// POST .../analysis/refine and PATCH .../analysis/field endpoints).
// Before these tables existed the save overwrote the AI value in place,
// so the AI original, the analyst's instruction, and the identity of
// the editor were all destroyed on write — the highest-value training
// signal in the product was discarded as a side effect of using it.
//
// Two tables, because a *rejected* suggestion is as informative as an
// accepted one:
//   - AiFieldRefinement → one row per refine call (what was asked, what
//     the model proposed). Rows with appliedAt = null are suggestions
//     the analyst chose not to keep.
//   - AiFieldEdit       → one row per save (before → after, by whom),
//     linked back to the refinement when the save followed one.
//
// Neither carries a hard FK to the analysed entity: entityKind spans
// four different tables, and these rows must outlive re-analysis (which
// deletes and recreates analysis rows) to stay useful as a corpus.
// ============================================

/// Entity families that expose refinable AI analysis fields. Values match
/// AiAnalysisRefineService's entityKind: "post" | "article" | "profile" | "video".
enum AiFieldEntityKind {
  POST
  ARTICLE
  PROFILE
  VIDEO
}

/// One AI refine invocation. Written before the model is called so a
/// failed or abandoned refine is still visible, then completed with the
/// proposal. `appliedAt`/`appliedEditId` are set only if the analyst
/// went on to save the result.
model AiFieldRefinement {
  id String @id @default(cuid())

  entityKind AiFieldEntityKind
  /// Id of the post / article / profile / video being analysed.
  entityId   String
  /// Analysis field key, e.g. "summary", "mainThemes", "topicClusters".
  field      String

  /// The analyst's natural-language instruction. This is the single most
  /// valuable label the system produces — it states, in words, what was
  /// wrong with the model's output.
  prompt String @db.Text

  /// Field value at the moment the refine was requested (the AI original,
  /// unless the field had already been edited). JSON because field types
  /// vary: text, string[], and topic-cluster objects.
  valueBefore Json?
  /// What the model returned. Null if the call failed — see `error`.
  aiProposed  Json?
  /// Failure message when the refine did not produce a usable value.
  error       String?

  /// Provenance of the model that produced `aiProposed`, so a corpus can
  /// be filtered by the model/prompt that generated it. Mirrors the
  /// pattern already used by TrendingCategoryIntelligence.
  modelProvider String?
  modelName     String?
  promptKind    String?

  /// Null for anonymous / service actions. Not a hard FK on purpose.
  actorId    String?
  actorEmail String?

  /// Set when a subsequent save persisted a value derived from this refine.
  appliedAt     DateTime?
  appliedEditId String?   @unique

  createdAt DateTime @default(now())

  appliedEdit AiFieldEdit? @relation(fields: [appliedEditId], references: [id], onDelete: SetNull)

  @@index([entityKind, entityId, field])
  @@index([actorId, createdAt])
  @@index([appliedAt])
  @@index([createdAt])
  @@map("ai_field_refinements")
}

/// One persisted edit to an AI analysis field. `valueBefore` is what the
/// row held immediately before the write, so (valueBefore → valueAfter)
/// is a directly usable correction pair.
model AiFieldEdit {
  id String @id @default(cuid())

  entityKind AiFieldEntityKind
  entityId   String
  field      String

  valueBefore Json?
  valueAfter  Json?

  /// REFINE_SAVE  → the analyst saved (possibly after hand-editing) a value
  ///                the model proposed; `refinement` is populated.
  /// DIRECT_SAVE  → the analyst typed the value without asking the model.
  source AiFieldEditSource @default(DIRECT_SAVE)

  /// True when the saved value differs from what the model proposed —
  /// i.e. the analyst accepted the suggestion only partially.
  divergedFromProposal Boolean @default(false)

  actorId    String?
  actorEmail String?

  createdAt DateTime @default(now())

  refinement AiFieldRefinement?

  @@index([entityKind, entityId, field, createdAt])
  @@index([actorId, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
  @@map("ai_field_edits")
}

/// One analyst's verdict on one piece of AI output.
///
/// Exists because no quality signal was being harvested anywhere: analysts
/// could silently disagree with the model and nothing recorded it, so the
/// training corpus only ever saw the outputs someone bothered to rewrite.
/// A vote is the cheapest possible label and the only one that can be given
/// on output that is *correct* — which is what makes it the counterweight to
/// the selection bias baked into a corrections-only corpus.
model AiFeedbackVote {
  id String @id @default(cuid())

  entityKind AiFieldEntityKind
  entityId   String
  /// Empty string means the verdict is on the analysis as a whole; a field key
  /// scopes it to one part of the output, e.g. "summary". Deliberately NOT
  /// nullable: Postgres treats NULLs as distinct in a unique index, so a
  /// nullable `field` would let whole-analysis votes stack per analyst and turn
  /// the DOWN count into a count of clicks rather than of people.
  field      String            @default("")

  verdict AiFeedbackVerdict
  /// Optional free text. The vote says the output was wrong; this says why,
  /// and it is worth far more per row than the verdict itself.
  note    String?           @db.Text

  /// Snapshot of what was voted on. Kept because the underlying analysis is
  /// mutable — an analyst may correct it minutes later, and without this the
  /// vote would point at a value that no longer exists.
  valueVoted Json?

  /// Provenance of the model that produced the voted output, so the corpus
  /// can be filtered by the model/prompt that generated it.
  modelProvider String?
  modelName     String?
  promptVersion String?

  /// Null for anonymous / service actions. Not a hard FK on purpose.
  actorId    String?
  actorEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One vote per analyst per field. Re-voting updates in place rather than
  /// stacking, so a count of DOWN votes is a count of people, not of clicks.
  /// Binds only for identified actors — a NULL `actorId` is distinct from every
  /// other NULL in Postgres. That is acceptable because every route that writes
  /// here is behind `JwtAuthGuard`, which mints a principal even for workers.
  @@unique([entityKind, entityId, field, actorId], map: "ai_feedback_votes_actor_unique")
  @@index([entityKind, entityId, field])
  @@index([verdict, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("ai_feedback_votes")
}

/// Whole-output verdict from an analyst. Deliberately coarse: the point of
/// a thumbs-up/down is that it costs one click, so it gets used. Field-level
/// corrections live in AiFieldEdit / AiFieldRefinement instead.
/// How a labelling round drew its sample. Recorded because it decides whether
/// the resulting labels can be read as a population estimate directly, or must
/// be reweighted first.
/// Where a mention was found. Wider than `AiFieldEntityKind` because mentions
/// occur in content that carries no AI-analysis row of its own — a comment, a
/// headline — and the whole point is to reach the content the legacy
/// ScrapeResult-anchored table could not.
enum MentionSourceKind {
  ARTICLE
  HEADLINE
  POST
  COMMENT
  VIDEO_SEGMENT
}

/// How an alias or link came to exist. Human-supplied links must outrank
/// model-supplied ones at merge time, and cannot be silently overwritten by a
/// later extraction run.
enum EntityLinkSource {
  AI
  ANALYST
  IMPORT
}

/// A canonical real-world entity — one person, organisation, or place.
///
/// This is the join `entities` never provided: "every article mentioning
/// Person X" is `EntityMention` filtered by `entityId`, across news, social and
/// comments alike. Today entities live as JSON blobs on analysis rows, so the
/// question is not answerable at all.
model Entity {
  id   String     @id @default(cuid())
  type EntityType

  /// Preferred display form, in whichever script the analysts use for it.
  canonicalName String
  /// `romanizationKey(canonicalName)` from libs/bangla-text — the fuzzy
  /// cross-script key that lets শেখ হাসিনা, "Sheikh Hasina" and "sheik hasina"
  /// find each other.
  ///
  /// Indexed but deliberately **NOT unique**: the key is a recall device that
  /// over-matches by design (`hasina` and `hasan` both reduce to `hsn`).
  /// A unique constraint here would merge two different people and present the
  /// result as fact.
  canonicalKey  String?
  description   String? @db.Text

  /// Model confidence in the entity itself, distinct from confidence in any
  /// single mention of it.
  confidence Float?

  /// Human confirmation. An identity assertion in an OSINT product should be a
  /// recommendation with a recorded human decision behind it, not a machine
  /// fact — the same posture the video-speaker flow already takes.
  verifiedAt DateTime?
  verifiedBy String?

  /// Set when this entity was merged into another. The row is kept rather than
  /// deleted so existing mentions stay resolvable and the merge is reversible;
  /// an unexplained merge is indistinguishable from data loss.
  mergedIntoId String?
  mergedInto   Entity?   @relation("EntityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Entity[]  @relation("EntityMerge")
  mergedAt     DateTime?
  mergedBy     String?
  mergeReason  String?

  modelProvider String?
  modelName     String?
  promptVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  aliases  EntityAlias[]
  mentions EntityMention[]

  @@index([type, canonicalKey])
  @@index([canonicalKey])
  @@index([canonicalName])
  @@index([mergedIntoId])
  @@map("canonical_entities")
}

/// A surface form that resolves to an entity — including across scripts.
model EntityAlias {
  id       String @id @default(cuid())
  entityId String @map("entity_id")
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  /// The literal text as written.
  surface         String
  /// "bn" | "en" | "bn-Latn" | "mixed", matching the content language columns.
  script          String?
  /// Fuzzy cross-script key for this surface form. Indexed, not unique — see
  /// Entity.canonicalKey for why uniqueness here would be a bug.
  romanizationKey String? @map("romanization_key")

  source     EntityLinkSource @default(AI)
  confidence Float?
  createdBy  String?

  createdAt DateTime @default(now())

  /// One row per surface form per entity, so re-running extraction is
  /// idempotent instead of accumulating duplicates.
  @@unique([entityId, surface], map: "entity_aliases_entity_surface_unique")
  @@index([romanizationKey])
  @@index([surface])
  @@map("entity_aliases")
}

/// One occurrence of an entity in one piece of content.
model EntityMention {
  id String @id @default(cuid())

  /// Nullable on purpose. Extraction and resolution are separate steps: forcing
  /// a link at extraction time would either discard unresolved mentions or
  /// mint a junk entity for every spelling variant. An unresolved mention is
  /// still evidence, and is the queue for the resolver.
  entityId String? @map("entity_id")
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  sourceKind MentionSourceKind
  /// Id of the article / post / comment. Not a hard FK — one column cannot
  /// reference five tables — so deletes are reconciled, not cascaded.
  sourceId   String            @map("source_id")

  /// Text as it appeared, which is what makes a new alias discoverable.
  surface String
  type    EntityType

  confidence Float?
  /// Character offsets into the normalized content, for highlighting and for
  /// checking an extraction against the text it claims to come from.
  startPos   Int?
  endPos     Int?

  modelProvider String?
  modelName     String?
  promptVersion String?

  createdAt DateTime @default(now())

  /// Makes re-analysis idempotent: the same span extracted twice updates one
  /// row instead of stacking. The lesson from video topics, applied up front.
  @@unique([sourceKind, sourceId, surface, startPos], map: "entity_mentions_span_unique")
  @@index([entityId])
  @@index([sourceKind, sourceId])
  @@index([type])
  @@index([createdAt])
  @@map("entity_mentions")
}

enum LabellingSampleMethod {
  /// Every analysed item in the window had an equal chance of selection. The
  /// only method whose labels are an unbiased estimate of live quality.
  UNIFORM
  /// Sampled within model-predicted strata to reach rare classes sooner.
  /// Faster to find interesting cases, but the sample is model-dependent and
  /// MUST be reweighted by `selectionWeight` before any rate is quoted.
  STRATIFIED
}

enum LabellingTaskStatus {
  PENDING
  LABELLED
  /// Analyst could not judge it — kept, because a high skip rate is itself a
  /// finding about the task or the data.
  SKIPPED
}

/// One drawn sample of items for an analyst to label.
///
/// Exists to counter the selection bias baked into every other signal the
/// system collects. Corrections and votes only ever land on output an analyst
/// happened to open, so a model trained on them learns about its own outputs,
/// not about the world — and its measured quality is quality *on the items it
/// surfaced*, which is exactly the number that cannot be trusted.
///
/// A round is drawn **independently of what the model said**, so the labels
/// support a population estimate: how good is the analysis on a typical item,
/// including the ones nobody looked at.
model LabellingRound {
  id   String  @id @default(cuid())
  name String?

  entityKind AiFieldEntityKind
  /// Analysis field being judged, e.g. "sentimentLabel".
  field      String

  method LabellingSampleMethod @default(UNIFORM)
  /// Seed for the draw. The sample is a pure function of (seed, population),
  /// so a round can be re-derived and audited rather than taken on trust.
  seed   String

  /// Sampling frame. Both bounds are stored so the population a rate refers to
  /// is never ambiguous.
  windowStart DateTime
  windowEnd   DateTime

  targetSize     Int
  /// Rows in the frame at draw time — the denominator for `selectionWeight`.
  populationSize Int

  createdBy String?
  createdAt DateTime @default(now())

  tasks LabellingTask[]

  @@index([entityKind, field])
  @@index([createdAt])
  @@map("labelling_rounds")
}

/// One item awaiting, or carrying, a human label.
model LabellingTask {
  id      String         @id @default(cuid())
  roundId String         @map("round_id")
  round   LabellingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  entityKind AiFieldEntityKind
  entityId   String
  field      String

  /// 1 / P(selected). 1.0 under UNIFORM; under STRATIFIED it is what makes an
  /// over-sampled stratum count correctly in an aggregate.
  selectionWeight Float   @default(1)
  stratum         String?

  status LabellingTaskStatus @default(PENDING)

  /// The model's answer, captured when the task was drawn.
  ///
  /// Snapshotted rather than read at review time because the analysis is
  /// mutable — a correction minutes later would otherwise silently rewrite
  /// what the model was judged on, and agreement would measure nothing.
  aiValue         Json?
  aiModelProvider String?
  aiModelName     String?
  aiPromptVersion String?

  /// The analyst's independent answer.
  label String?
  note  String? @db.Text

  /// False means the analyst committed a label before the model's answer was
  /// shown. Kept because automation bias is real and measurable: agreement
  /// from a blind label means something, agreement after seeing the model's
  /// answer largely does not.
  sawAiBeforeLabel Boolean @default(false)

  /// Null until labelled. Denormalised so agreement can be aggregated without
  /// re-deriving the comparison.
  agreesWithAi Boolean?

  assignedTo String?
  labelledBy String?
  labelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// An item is drawn at most once per round.
  @@unique([roundId, entityKind, entityId, field], map: "labelling_tasks_round_entity_unique")
  @@index([roundId, status])
  @@index([status, assignedTo])
  @@index([entityKind, entityId])
  @@map("labelling_tasks")
}

enum AiFeedbackVerdict {
  UP
  DOWN
}

enum AiFieldEditSource {
  REFINE_SAVE
  DIRECT_SAVE
}

// ============================================
// REPORT TAXONOMY — user-editable category / topic-group / source-
// group definitions the report-builder consumes. Initially seeded
// from the constants under apps/core-service/src/reports/seed/, but
// mutable from the admin UI so analysts can add categories /
// keywords without a code change.
//
// Naming is deliberately client-neutral:
//   - ReportCategory   → keyword-matched categories with a preset
//                        (e.g. ECONOMY) — used by the Negative-
//                        Coverage Index block as section headers.
//   - ReportTopicGroup → keyword-matched content grouping used by
//                        the Outlet-Grouped Headlines block (the
//                        WING_COMPILATION preset).
//   - ReportSourceGroup → display-only source-origin labels used by
//                        the Propaganda Source Tracker block.
//
// Scope is global today (single-tenant deployment); a userId column
// can be added later as a non-breaking change to enable per-user
// customization.
// ============================================

/// Top-level taxonomy preset that groups Categories together (e.g.
/// ECONOMY, POLITICS). Promoted from a Prisma enum to a table in
/// migration `20260518130000_promote_report_category_preset_to_table`
/// so analysts can add presets (DEFENSE, FOREIGN_AFFAIRS, …) without
/// a code change. Keys are stable identifiers used by block specs
/// (the `negativeCoverage` block stores `preset: "ECONOMY"` etc.);
/// renaming a key would break those blocks until they migrate.
model ReportCategoryPreset {
  id          String    @id @default(cuid())
  key         String    @unique
  labelBn     String
  labelEn     String
  /// Free-form context for analysts maintaining the preset — what it
  /// covers, when to use it. Surfaced in the admin UI.
  description String?
  order       Int       @default(0)
  isSystem    Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  /// Soft-delete timestamp. NULL = active, non-NULL = archived. Reads
  /// from resolvers and block dialogs filter `deletedAt: null`; the
  /// row stays in place so historical reports that reference its key
  /// keep resolving. Admin UI can restore by clearing this field.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categories ReportCategory[]

  @@index([order])
  @@index([deletedAt])
  @@map("report_category_presets")
}

/// Keyword-matched category used by the Negative-Coverage Index
/// block to section articles. One row per (presetId, key) —
/// e.g. (<ECONOMY preset id>, "banking_finance"). `keywords` is a
/// multilingual substring list matched against NewsArticle.title /
/// category / content. `isSystem=true` flags rows originally seeded
/// from code; UI shows a "reset to defaults" affordance that
/// re-upserts these.
model ReportCategory {
  id          String    @id @default(cuid())
  presetId    String
  key         String
  labelBn     String
  labelEn     String
  /// Optional "what this category is for" note — helps avoid drift
  /// between system rows and analyst-added customs when tuning
  /// keywords over time.
  description String?
  keywords    String[]  @default([])
  order       Int       @default(0)
  isSystem    Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  /// Soft-delete timestamp — see ReportCategoryPreset.deletedAt.
  /// Cascade-on-delete from the parent preset: soft-deleting a preset
  /// stamps `deletedAt` on every child category in the same
  /// transaction. Restore is per-row (not cascaded) so analysts can
  /// resurrect a preset without un-archiving categories they had
  /// already filtered out manually.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  preset ReportCategoryPreset @relation(fields: [presetId], references: [id], onDelete: Restrict)

  @@unique([presetId, key])
  @@index([presetId, order])
  @@index([deletedAt])
  @@map("report_categories")
}

/// Keyword-matched content grouping used by the Outlet-Grouped
/// Headlines block's WING_COMPILATION preset. Matches against
/// NewsArticle fields the same way as ReportCategory keywords.
model ReportTopicGroup {
  id          String    @id @default(cuid())
  key         String    @unique
  labelBn     String
  labelEn     String
  description String?
  keywords    String[]  @default([])
  order       Int       @default(0)
  isSystem    Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  /// Soft-delete timestamp — see ReportCategoryPreset.deletedAt.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
  @@index([deletedAt])
  @@map("report_topic_groups")
}

/// Topic taxonomy used to classify notifications into the desk's fixed
/// Bengali reporting categories (দৈনন্দিন রিপোর্টের বিষয়বস্তু). Admin-editable
/// and DB-seeded; `keywords` drive the keyword-first classification pass,
/// with an AI fallback on no-hit/tie. Mirrors ReportTopicGroup.
model NotificationCategory {
  id          String    @id @default(cuid())
  key         String    @unique
  labelBn     String
  labelEn     String
  description String?
  keywords    String[]  @default([])
  order       Int       @default(0)
  isSystem    Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  /// Soft-delete timestamp — see ReportCategoryPreset.deletedAt.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
  @@index([deletedAt])
  @@map("notification_categories")
}

/// Display-only source-origin group used by the Propaganda Source
/// Tracker block. Note: matching logic (the Prisma WHERE for each
/// group) is hardcoded in the resolver for the seeded keys
/// (INDIAN_FB_YT / BD_FB / BLOGGERS / TWITTER / TELEGRAM). User-added
/// rows render in the UI but won't match posts until matching rules
/// are introduced — the admin form flags this for non-seeded keys.
model ReportSourceGroup {
  id          String    @id @default(cuid())
  key         String    @unique
  labelBn     String
  labelEn     String
  description String?
  order       Int       @default(0)
  /// Explicit campaign assignment — the propaganda sources the analyst
  /// picked for this group in the taxonomy admin. The resolver joins
  /// exactly these campaigns (org-wide) + their posts; a group with no
  /// assigned campaigns renders empty.
  campaignIds String[]  @default([])
  isSystem    Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  /// Soft-delete timestamp — see ReportCategoryPreset.deletedAt.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
  @@index([deletedAt])
  @@map("report_source_groups")
}

// ============================================
// WILD SEARCH BOOKMARKS
// ============================================

/// A saved / favourited result from the Profile Wild Search panel.
/// One row per bookmarked mention, scoped to the campaign (profile).
model WildSearchBookmark {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// The headline / title of the saved result.
  title String @db.Text

  /// Optional full text snippet or body.
  content String? @db.Text

  /// Direct URL to the source article / post.
  url String? @map("url") @db.Text

  /// Thumbnail / preview image URL (if any).
  imageUrl String? @map("image_url") @db.Text

  /// Human-readable source name (e.g. "The Daily Star").
  sourceName String? @map("source_name")

  /// Published-at text as returned by the scraper (may be relative like "2h ago").
  publishedAtText String? @map("published_at_text")

  /// ISO timestamp when the item was scraped.
  scrapedAt DateTime? @map("scraped_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([campaignId, url, title], map: "wsb_campaign_url_title_key")
  @@index([campaignId], map: "wsb_campaign_id_idx")
  @@index([createdAt], map: "wsb_created_at_idx")
  @@index([url], map: "wsb_url_idx")
  @@map("wild_search_bookmarks")
}

// ============================================
// REPORT BOOKMARKS (Report Cart)
// ============================================

/// A user-created folder/collection that groups bookmarked items together,
/// like Facebook's "Saved" collections. A bookmark belongs to at most one
/// collection; a null `collectionId` means it lives in the default
/// "Uncategorized" bucket.
model BookmarkCollection {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Display name of the collection (e.g. "Election 2026", "Viral Posts").
  name        String
  /// Optional description shown under the name in the UI.
  description String? @map("description")
  /// Optional hex color used for the collection chip/icon in the UI.
  color       String?
  /// Optional emoji or lucide icon key used for the collection icon.
  icon        String?

  bookmarks ReportBookmark[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name], map: "bc_user_name_key")
  @@index([userId], map: "bc_user_id_idx")
  @@map("bookmark_collections")
}

/// A bookmarked news article or social post collected for report generation.
/// One row per bookmarked item, scoped to the user who bookmarked it.
model ReportBookmark {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The original item ID (SocialPost.id or NewsArticle.id).
  itemId String @map("item_id")

  /// 'news' or 'social'.
  itemType String @map("item_type")

  /// Optional reference to the BookmarkCollection this item belongs to.
  /// Null means the item is in the default "Uncategorized" bucket.
  collectionId String?             @map("collection_id")
  collection   BookmarkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, itemId], map: "rb_user_item_key")
  @@index([userId], map: "rb_user_id_idx")
  @@index([collectionId], map: "rb_collection_id_idx")
  @@index([createdAt], map: "rb_created_at_idx")
  @@map("report_bookmarks")
}

/// Live stream recording channel — stores a YouTube live URL and its topics.
/// Each topic has its own schedule (start/end/chunk) and produces a separate
/// video in the `videos` table after recording completes.
model LiveRecordChannel {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topics LiveRecordTopic[]

  @@map("live_record_channels")
}

/// One topic within a live recording channel. Each topic is recorded as a
/// separate segment and saved as its own row in the `videos` table.
model LiveRecordTopic {
  id           String            @id @default(cuid())
  channelId    String            @map("channel_id")
  channel      LiveRecordChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  topicName    String            @map("topic_name")
  startTime    String            @map("start_time")
  endTime      String            @map("end_time")
  chunkSeconds Int               @default(30) @map("chunk_seconds")
  /// Schedule type: ONE_TIME | RECURRING_DAILY
  scheduleType String            @default("ONE_TIME") @map("schedule_type")
  /// Date string (YYYY-MM-DD) of the last recording start for recurring topics
  lastRunDate  String?           @map("last_run_date")
  /// Recording status: PENDING | RECORDING | COMPLETED | FAILED
  status       String            @default("PENDING")
  /// Worker-video job ID for polling progress
  jobId        String?           @map("job_id")
  /// Progress percent 0-100
  percent      Int               @default(0)
  /// Status message from the worker
  message      String?
  /// The video row created when recording completes
  videoId      String?           @map("video_id")
  video        Video?            @relation(fields: [videoId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([channelId], map: "lrt_channel_id_idx")
  @@index([status], map: "lrt_status_idx")
  @@map("live_record_topics")
}

// ── falcon-gateway–owned tables ───────────────────────────────────────────────
//
// These four tables and two enums are created and used exclusively by
// apps/falcon-gateway, which carries its own self-contained Prisma schema and
// connects to this same `falcon_ai` database.
//
// They are mirrored here for ONE reason: `prisma db push` makes the database
// match the schema it is given, which includes DROPPING tables it does not know
// about — and it does so without prompting for --accept-data-loss when the
// table happens to be empty. With these models absent, a routine `make db-push`
// silently deleted the gateway's tables, and the gateway (which only bootstraps
// its schema at startup) kept running until the next read failed with P2021
// "table does not exist".
//
// Declaring them here makes core's db push preserve them instead.
//
// The gateway remains the owner: apps/falcon-gateway/src/prisma/db-init.service.ts
// creates them at boot and prisma/init.sql holds the canonical DDL. These
// definitions are a mirror and MUST stay byte-compatible with
// apps/falcon-gateway/prisma/schema.prisma — if a column changes there, change
// it here too, or the next db push will try to "correct" the live table.
//
// (This mirrors what the gateway already does in the other direction: it
// redeclares Campaign, SocialPost, NewsArticle, Video and friends read-only.)

enum IntegrationClientStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD
}

model IntegrationClient {
  id            String                  @id @default(cuid())
  name          String
  description   String?
  keyId         String                  @unique @map("key_id")
  secretEnc     String                  @map("secret_enc")
  scopes        String[]                @default([])
  ipAllowlist   String[]                @default([]) @map("ip_allowlist")
  status        IntegrationClientStatus @default(ACTIVE)
  rateLimitRpm  Int                     @default(120) @map("rate_limit_rpm")
  searchEnabled Boolean                 @default(false) @map("search_enabled")
  ipEnforced    Boolean                 @default(true) @map("ip_enforced")
  lastUsedAt    DateTime?               @map("last_used_at")
  createdBy     String?                 @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at")

  webhookEndpoints WebhookEndpoint[]
  deliveries       WebhookDelivery[]
  requestLogs      RequestLog[]

  @@index([status], map: "integration_client_status_idx")
  @@map("integration_clients")
}

/// Append-only audit of every authenticated external request. Pruned by age.
model RequestLog {
  id            String            @id @default(cuid())
  clientId      String            @map("client_id")
  client        IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  method        String
  path          String
  statusCode    Int               @map("status_code")
  durationMs    Int?              @map("duration_ms")
  responseBytes Int?              @map("response_bytes")
  ip            String?
  userAgent     String?           @map("user_agent")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([clientId, createdAt], map: "request_log_client_created_idx")
  @@index([createdAt], map: "request_log_created_idx")
  @@map("request_logs")
}

model WebhookEndpoint {
  id            String            @id @default(cuid())
  clientId      String            @map("client_id")
  client        IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url           String
  signingSecret String            @map("signing_secret")
  events        String[]          @default([])
  enabled       Boolean           @default(true)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([clientId], map: "webhook_endpoint_client_idx")
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  endpointId   String                @map("endpoint_id")
  endpoint     WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  clientId     String                @map("client_id")
  client       IntegrationClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?                  @map("response_code")
  errorMessage String?               @map("error_message")
  nextRetryAt  DateTime?             @map("next_retry_at")
  deliveredAt  DateTime?             @map("delivered_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")

  @@index([status, nextRetryAt], map: "webhook_delivery_status_retry_idx")
  @@index([endpointId], map: "webhook_delivery_endpoint_idx")
  @@map("webhook_deliveries")
}

// ============================================
// AI CHAT — persisted conversation history
// ============================================

enum ChatThreadStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// A conversation thread belonging to a single user. Created on first
/// chat turn (or explicitly via POST /ai-chat/threads). The Python
/// falcon-ai-service reads/writes these via asyncpg raw SQL; Prisma
/// owns the DDL and the NestJS core-service manages thread CRUD with
/// JWT-authenticated user isolation.
model ChatThread {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String           @default("New Chat")
  status    ChatThreadStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_threads")
}

/// Individual messages within a chat thread. The metadata JSONB column
/// stores retrieval references, run IDs, provider/model info, and agent
/// trace data emitted by the Python streaming pipeline.
model ChatMessage {
  id        String          @id @default(cuid())
  threadId  String
  thread    ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      ChatMessageRole
  content   String          @db.Text
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
  @@map("chat_messages")
}
