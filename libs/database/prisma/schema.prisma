model PostAIAnalysis {
  id              String          @id @default(cuid())
  postId          String
  post            SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Analysis metadata
  lastAnalyzedAt  DateTime        @default(now())
  
  // Post Summary
  summary         String          @db.Text

  // AI hybrid search content (BGE-M3, 1024 dimensions)
  searchTsv       Unsupported("tsvector")? @map("search_tsv")
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")

  // Single-sentence Bengali rationale: WHY this post is viral. Combines
  // content (topic / emotional weight) with comparative signal (velocity
  // vs channel baseline, share-to-reaction ratio). Surfaced in the
  // Investigation / viral-posts cards as the lead "Why this is viral?" line.
  viralityRationale String?        @db.Text

  // Overall Sentiment
  sentimentScore       Float?     // -1 to 1 or 0-100
  sentimentLabel       String?    // POSITIVE, NEGATIVE, NEUTRAL, MIXED
  sentimentBreakdown   Json?      // {positive: 60, neutral: 25, negative: 15}
  
  // Viral Potential
  viralPotentialScore  Float?     // 0 to 100
  viralPotentialLabel  String?    // LOW, MEDIUM, HIGH, VIRAL
  viralFactors         Json?      // [{factor, impact, description}, ...]
  
  // Audience Insights
  audienceDemographics Json?      // {techProfessionals: 45, founders: 20, developers: 25, other: 10}
  activeHours          String[]   @default([])  // Peak engagement hours
  topLocations         String[]   @default([])
  
  // Content Analysis
  mainThemes           String[]   @default([])
  engagementTriggers   String[]   @default([])
  keywords             String[]   @default([])
  languageStyle        String?
  toneAnalysis         String?    // Informative, Persuasive, Emotional, etc.
  
  // Engagement Prediction
  expectedLikes        Int?
  expectedComments     Int?
  expectedShares       Int?
  engagementRate       Float?
  
  // AI Recommendations
  aiRecommendations    Json?      // {intro, concerns: [{title, description}], proposedActions: [...]}
  
  // Risk Assessment
  riskAssessment       Json?      // {overallRisk, riskScore, categories: [{category, level, score}]}
  
  // Detected Entities
  detectedEntities     Json?      // {organizations: [], people: [], topics: [], locations: []}
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([postId])
  @@index([lastAnalyzedAt])
  @@map("post_ai_analysis")
}

model NewsAIAnalysis {
