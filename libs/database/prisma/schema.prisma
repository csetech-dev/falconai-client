  INFLUENCER
  BRAND
  MEDIA
  GOVERNMENT
  OTHER
}

enum ActionType {
  MONITOR
  TRACK
  ANALYZE
  ENGAGE
  REPORT
  NON_MONITOR
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
  PAUSED
  ARCHIVED
}

enum ProfilePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SuspicionStatus {
  CLEAN
  SUSPECTED
  FLAGGED
  CONFIRMED_BOT
  IGNORED
}

enum CommentCategory {
  PRAISE
  QUESTION
  COMPLAINT
  NEUTRAL
  SPAM
  OTHER
}

enum AnalyticsPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
  CARE
  OTHER
}

enum JobPriority {
