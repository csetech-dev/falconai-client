  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@map("profile_feedback")
}

// ============================================
// VIDEO INTELLIGENCE
// ============================================

enum VideoKind {
  GENERAL
  TALK_SHOW
  LIVE
}

enum VideoIngestionMethod {
  CAMPAIGN_SCRAPE
  DIRECT_LINK
  FILE_UPLOAD
}

enum VideoAnalysisStatus {
  NOT_SENT
  QUEUED
  ANALYZING
  COMPLETED
  FAILED
}

enum VideoAiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum SegmentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum RedFlagSeverity {
  LOW
  MEDIUM
  HIGH
}

model VideoKeyword {
