# ─────────────────────────────────────────────────────────────────────────────
# FalconAI sizing profile — PRODUCTION server (495 GB RAM, 124 cores)
#
# VENDOR-MANAGED FILE. Edits here are overwritten on the next client bundle
# update. To change a single knob on your host, set it in .env.app (app stack)
# or .env.storage (storage stack) instead — those are layered after this file
# and win.
#
# Selected by FALCON_SIZING_PROFILE=prod in .env.app / .env.storage.
#
# Budget: memory *limits* sum to ~424 GB (86% of 495 GB), leaving ~70 GB for the
# OS and page cache. CPU ceilings sum to ~177 against 124 cores — deliberate,
# since `cpus` is a burst cap and the browser workers are I/O-bound in bursts.
#
# Raising the container ceilings alone does nothing: the throughput comes from
# the concurrency knobs below (gunicorn/uvicorn workers, browser lanes, queue
# concurrency). Keep the two in step when you tune.
# ─────────────────────────────────────────────────────────────────────────────

# ── Datastores ───────────────────────────────────────────────────────────────
FALCON_SZ_OS_MEM=24G
FALCON_SZ_OS_CPU=8
FALCON_SZ_OS_MEM_RES=4G
FALCON_SZ_OS_CPU_RES=2
# Stay under ~31G or the JVM loses compressed oops and effectively wastes memory.
# Also keep it <= 50% of FALCON_SZ_OS_MEM so Lucene gets the rest as page cache.
OPENSEARCH_JAVA_OPTS=-Xms12g -Xmx12g

FALCON_SZ_REDIS_MEM=16G
FALCON_SZ_REDIS_CPU=4
FALCON_SZ_REDIS_MEM_RES=2G
FALCON_SZ_REDIS_CPU_RES=1
# BullMQ requires maxmemory-policy=noeviction, so this is a hard wall: when it
# fills, every enqueue fails. Keep it well under FALCON_SZ_REDIS_MEM.
REDIS_MAXMEMORY=12gb

# Storage stack (postgres/minio). Set FALCON_SIZING_PROFILE per HOST — use these
# values only if the storage stack runs on the big box. On a smaller dedicated
# storage host, set FALCON_SIZING_PROFILE=test in .env.storage there.
FALCON_SZ_PG_MEM=64G
FALCON_SZ_PG_CPU=16
FALCON_SZ_PG_MEM_RES=8G
FALCON_SZ_PG_MAX_CONN=600
FALCON_SZ_PG_SHARED_BUFFERS=32GB
FALCON_SZ_PG_CACHE=192GB
# work_mem is per sort/hash node, not per connection — 24MB x 600 is a floor,
# not a ceiling. It is sized against the 64G container limit with that in mind.
FALCON_SZ_PG_WORK_MEM=24MB
FALCON_SZ_PG_MAINT_WORK_MEM=4GB
FALCON_SZ_PG_IO_CONCURRENCY=300
FALCON_SZ_PG_MAX_WAL_SIZE=32GB

FALCON_SZ_MINIO_MEM=8G
FALCON_SZ_MINIO_CPU=4
FALCON_SZ_MINIO_MEM_RES=1G

# ── Node / NestJS services ───────────────────────────────────────────────────
# core runs as TWO containers, and this section sizes both halves of what used
# to be one:
#
#   falcon-core             SERVICE_ROLE=api        dashboard HTTP + SSE
#   falcon-core-automation  SERVICE_ROLE=automation schedulers, queue consumers,
#                                                   AI loops, machine ingest
#
# Node is single-threaded, so the old 12-CPU ceiling on one process was mostly
# unusable — two processes is what actually buys the parallelism. The two add up
# to the previous single-container budget (24G / 12 CPU), so this is a
# redistribution, not an increase.
#
# The automation plane gets the larger heap and connection pool: it carries the
# scrape payloads and the AI batches, while the api plane mostly serializes
# query results.
#
# Reverting to one all-in-one container (CORE_SERVICE_ROLE=all plus stopping
# falcon-core-automation) means raising FALCON_SZ_CORE_MEM/CPU and
# CORE_NODE_HEAP_MB back to the combined figures in .env.app.
FALCON_SZ_CORE_MEM=10G
FALCON_SZ_CORE_CPU=5
FALCON_SZ_CORE_MEM_RES=2G
FALCON_SZ_CORE_CPU_RES=1
CORE_NODE_HEAP_MB=8192
CORE_UV_THREADPOOL_SIZE=32
CORE_DB_CONNECTION_LIMIT=30

FALCON_SZ_CORE_AUTO_MEM=14G
FALCON_SZ_CORE_AUTO_CPU=7
FALCON_SZ_CORE_AUTO_MEM_RES=2G
FALCON_SZ_CORE_AUTO_CPU_RES=1
CORE_AUTO_NODE_HEAP_MB=12288
CORE_AUTO_DB_CONNECTION_LIMIT=50
SOCIAL_SCRAPER_CONCURRENCY=64
NEWS_CORE_AUTO_PARALLEL=24
NEWS_MEDIA_SOURCE_PARALLEL=4

FALCON_SZ_AUTH_MEM=4G
FALCON_SZ_AUTH_CPU=2
FALCON_SZ_AUTH_MEM_RES=512M
FALCON_SZ_AUTH_CPU_RES=0.5
AUTH_DB_POOL_MAX=40

FALCON_SZ_ANALYTICS_MEM=4G
FALCON_SZ_ANALYTICS_CPU=2
FALCON_SZ_ANALYTICS_MEM_RES=512M
FALCON_SZ_ANALYTICS_CPU_RES=0.5
ANALYTICS_DB_CONNECTION_LIMIT=30

FALCON_SZ_SEARCH_MEM=6G
FALCON_SZ_SEARCH_CPU=3
FALCON_SZ_SEARCH_MEM_RES=512M
FALCON_SZ_SEARCH_CPU_RES=0.5

FALCON_SZ_FGW_MEM=4G
FALCON_SZ_FGW_CPU=2
FALCON_SZ_FGW_MEM_RES=512M
FALCON_SZ_FGW_CPU_RES=0.5

FALCON_SZ_APIGW_MEM=4G
FALCON_SZ_APIGW_CPU=4

FALCON_SZ_KEYCLOAK_MEM=4G
FALCON_SZ_KEYCLOAK_CPU=2
FALCON_SZ_KEYCLOAK_MEM_RES=512M
FALCON_SZ_KEYCLOAK_CPU_RES=0.5

FALCON_SZ_FRONT_MEM=1G
FALCON_SZ_FRONT_CPU=1
FALCON_SZ_FRONT_MEM_RES=128M
FALCON_SZ_FRONT_CPU_RES=0.25

FALCON_SZ_PROXY_MEM=1G
FALCON_SZ_PROXY_CPU=1
FALCON_SZ_ADMINER_MEM=512M
FALCON_SZ_ADMINER_CPU=0.5
# nginx fan-out for the per-worker VNC viewers.
FALCON_SZ_VIEWER_MEM=1G
FALCON_SZ_VIEWER_CPU=2

# ── AI services ──────────────────────────────────────────────────────────────
FALCON_SZ_AIPY_MEM=40G
FALCON_SZ_AIPY_CPU=16
FALCON_SZ_AIPY_MEM_RES=8G
FALCON_SZ_AIPY_CPU_RES=4
# Each uvicorn worker holds its own browser session, so this multiplies memory.
# UVICORN_WORKERS x OMP_NUM_THREADS should stay under FALCON_SZ_AIPY_CPU.
AI_UVICORN_WORKERS=12
AI_OMP_NUM_THREADS=4
AI_MKL_NUM_THREADS=4

FALCON_SZ_INTAI_MEM=16G
FALCON_SZ_INTAI_CPU=6
FALCON_SZ_INTAI_MEM_RES=2G
FALCON_SZ_INTAI_CPU_RES=1
FALCON_SZ_INTAI_SHM=2gb

# ── Falcon Brain (separate AI host — see docs/FALCON_BRAIN_ARCHITECTURE.md) ───
# These size the *gateway* only: an async edge process that proxies to LiteLLM
# and holds no model weights, so it stays small. GPU serving containers are
# sized in docker-compose.brain.yml against the AI host's own budget, not the
# app host's — do not fold them into the totals at the top of this file.
FALCON_SZ_BRAIN_MEM=4G
FALCON_SZ_BRAIN_CPU=4
FALCON_SZ_BRAIN_MEM_RES=512M
FALCON_SZ_BRAIN_CPU_RES=1
BRAIN_UVICORN_WORKERS=8

# ── Scraper workers ──────────────────────────────────────────────────────────
# shm_size is RAM-backed tmpfs charged to the container's memory cgroup, and
# Chromium already runs with --disable-dev-shm-usage — these stay modest even
# here, and the extra headroom goes to the memory limit instead.
FALCON_SZ_NEWS_MEM=80G
FALCON_SZ_NEWS_CPU=32
FALCON_SZ_NEWS_MEM_RES=8G
FALCON_SZ_NEWS_CPU_RES=4
FALCON_SZ_NEWS_SHM=8gb
FALCON_SZ_NEWS_PIDS=8000
NEWS_WORKERS=12
NEWS_THREADS=4
SOURCE_WORKERS=6
NEWS_BROWSER_TOTAL_SLOTS=32
NEWS_BROWSER_STUDIO_RESERVED=4
NEWS_BROWSER_AUTO_SLOTS=20
NEWS_BROWSER_MAX_LIVE=32
NEWS_ARTICLE_EXECUTOR_WORKERS=48

FALCON_SZ_FB_MEM=64G
FALCON_SZ_FB_CPU=24
FALCON_SZ_FB_MEM_RES=8G
FALCON_SZ_FB_CPU_RES=4
FALCON_SZ_FB_SHM=8gb
FB_SCRAPE_THREADS=80
FB_METRICS_CONCURRENCY=16

FALCON_SZ_X_MEM=24G
FALCON_SZ_X_CPU=10
FALCON_SZ_X_MEM_RES=4G
FALCON_SZ_X_CPU_RES=2
FALCON_SZ_X_SHM=4gb

FALCON_SZ_LI_MEM=16G
FALCON_SZ_LI_CPU=6
FALCON_SZ_LI_MEM_RES=2G
FALCON_SZ_LI_CPU_RES=1
FALCON_SZ_LI_SHM=2gb

FALCON_SZ_WEBW_MEM=32G
FALCON_SZ_WEBW_CPU=16
FALCON_SZ_WEBW_MEM_RES=4G
FALCON_SZ_WEBW_CPU_RES=2
FALCON_SZ_WEBW_SHM=4gb

FALCON_SZ_IMAGE_MEM=16G
FALCON_SZ_IMAGE_CPU=8
FALCON_SZ_IMAGE_MEM_RES=2G
FALCON_SZ_IMAGE_CPU_RES=1
FALCON_SZ_IMAGE_SHM=4gb
IMAGE_MAX_CONCURRENT_TABS=20

FALCON_SZ_VIDEO_MEM=24G
FALCON_SZ_VIDEO_CPU=8
FALCON_SZ_VIDEO_MEM_RES=4G
FALCON_SZ_VIDEO_CPU_RES=1
FALCON_SZ_VIDEO_SHM=4gb
# GUNICORN_WORKERS stays 1 — the multi-account LaneManager semaphore lives in a
# single process. Width comes from threads and the download consumer instead.
VIDEO_WORKER_CONCURRENCY=8
VIDEO_GUNICORN_THREADS=32

FALCON_SZ_TG_MEM=4G
FALCON_SZ_TG_CPU=2
FALCON_SZ_TG_MEM_RES=512M
FALCON_SZ_TG_CPU_RES=0.5
FALCON_SZ_TG_SHM=1gb

FALCON_SZ_BOTDET_MEM=8G
FALCON_SZ_BOTDET_CPU=4
FALCON_SZ_BOTDET_MEM_RES=1G
FALCON_SZ_BOTDET_CPU_RES=1
BOT_DETECTION_WORKERS=8

FALCON_SZ_FLARE_MEM=8G
FALCON_SZ_FLARE_CPU=4
FALCON_SZ_FLARE_MEM_RES=1G
FALCON_SZ_FLARE_CPU_RES=1
