# ─────────────────────────────────────────────────────────────────────────────
# FalconAI sizing profile — TEST server (32 GB RAM, 6 cores / 12 threads)
#
# VENDOR-MANAGED FILE. Edits here are overwritten on the next client bundle
# update. To change a single knob on your host, set it in .env.app (app stack)
# or .env.storage (storage stack) instead — those are layered after this file
# and win.
#
# Selected by FALCON_SIZING_PROFILE=test in .env.app / .env.storage.
#
# Budget: memory *limits* sum to ~39 GB against 32 GB physical. Limits are
# ceilings, not reservations (those sum to ~8 GB), so mild overcommit is
# intended. CPU ceilings intentionally oversubscribe — `cpus` is a burst cap.
# ─────────────────────────────────────────────────────────────────────────────

# ── Datastores ───────────────────────────────────────────────────────────────
FALCON_SZ_OS_MEM=2G
FALCON_SZ_OS_CPU=2
FALCON_SZ_OS_MEM_RES=512M
FALCON_SZ_OS_CPU_RES=0.5
# Heap must stay <= 50% of FALCON_SZ_OS_MEM.
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

FALCON_SZ_REDIS_MEM=1G
FALCON_SZ_REDIS_CPU=1
FALCON_SZ_REDIS_MEM_RES=512M
FALCON_SZ_REDIS_CPU_RES=0.25
# BullMQ requires maxmemory-policy=noeviction, so this is a hard wall: when it
# fills, every enqueue fails. Keep it well under FALCON_SZ_REDIS_MEM.
REDIS_MAXMEMORY=640mb

# Storage stack (postgres/minio). Set FALCON_SIZING_PROFILE per HOST — if your
# storage host is a different size than your app host, they pick different files.
FALCON_SZ_PG_MEM=4G
FALCON_SZ_PG_CPU=2
FALCON_SZ_PG_MEM_RES=512M
FALCON_SZ_PG_MAX_CONN=150
FALCON_SZ_PG_SHARED_BUFFERS=1GB
FALCON_SZ_PG_CACHE=3GB
FALCON_SZ_PG_WORK_MEM=8MB
FALCON_SZ_PG_MAINT_WORK_MEM=256MB
FALCON_SZ_PG_IO_CONCURRENCY=200
FALCON_SZ_PG_MAX_WAL_SIZE=2GB

FALCON_SZ_MINIO_MEM=1G
FALCON_SZ_MINIO_CPU=1
FALCON_SZ_MINIO_MEM_RES=256M

# ── Node / NestJS services ───────────────────────────────────────────────────
# See .env.sizing.prod for what the two core planes are. Both halves are sized
# here; together they are the previous single-container budget, so this is a
# redistribution rather than an increase.
FALCON_SZ_CORE_MEM=1G
FALCON_SZ_CORE_CPU=1.5
FALCON_SZ_CORE_MEM_RES=128M
FALCON_SZ_CORE_CPU_RES=0.25
CORE_NODE_HEAP_MB=1024
CORE_UV_THREADPOOL_SIZE=16
CORE_DB_CONNECTION_LIMIT=7

FALCON_SZ_CORE_AUTO_MEM=2G
FALCON_SZ_CORE_AUTO_CPU=2
FALCON_SZ_CORE_AUTO_MEM_RES=256M
FALCON_SZ_CORE_AUTO_CPU_RES=0.5
CORE_AUTO_NODE_HEAP_MB=1536
CORE_AUTO_DB_CONNECTION_LIMIT=8
SOCIAL_SCRAPER_CONCURRENCY=10
NEWS_CORE_AUTO_PARALLEL=6
NEWS_MEDIA_SOURCE_PARALLEL=1

FALCON_SZ_AUTH_MEM=512M
FALCON_SZ_AUTH_CPU=1
FALCON_SZ_AUTH_MEM_RES=128M
FALCON_SZ_AUTH_CPU_RES=0.25
AUTH_DB_POOL_MAX=8

FALCON_SZ_ANALYTICS_MEM=512M
FALCON_SZ_ANALYTICS_CPU=1
FALCON_SZ_ANALYTICS_MEM_RES=128M
FALCON_SZ_ANALYTICS_CPU_RES=0.25
ANALYTICS_DB_CONNECTION_LIMIT=8

FALCON_SZ_SEARCH_MEM=512M
FALCON_SZ_SEARCH_CPU=1
FALCON_SZ_SEARCH_MEM_RES=128M
FALCON_SZ_SEARCH_CPU_RES=0.25

FALCON_SZ_FGW_MEM=512M
FALCON_SZ_FGW_CPU=1
FALCON_SZ_FGW_MEM_RES=128M
FALCON_SZ_FGW_CPU_RES=0.25

FALCON_SZ_APIGW_MEM=512M
FALCON_SZ_APIGW_CPU=1

FALCON_SZ_KEYCLOAK_MEM=1G
FALCON_SZ_KEYCLOAK_CPU=1
FALCON_SZ_KEYCLOAK_MEM_RES=256M
FALCON_SZ_KEYCLOAK_CPU_RES=0.25

FALCON_SZ_FRONT_MEM=256M
FALCON_SZ_FRONT_CPU=0.5
FALCON_SZ_FRONT_MEM_RES=64M
FALCON_SZ_FRONT_CPU_RES=0.1

FALCON_SZ_PROXY_MEM=256M
FALCON_SZ_PROXY_CPU=0.5
FALCON_SZ_ADMINER_MEM=256M
FALCON_SZ_ADMINER_CPU=0.5
# nginx fan-out for the per-worker VNC viewers.
FALCON_SZ_VIEWER_MEM=256M
FALCON_SZ_VIEWER_CPU=0.5

# ── AI services ──────────────────────────────────────────────────────────────
FALCON_SZ_AIPY_MEM=4G
FALCON_SZ_AIPY_CPU=2
FALCON_SZ_AIPY_MEM_RES=512M
FALCON_SZ_AIPY_CPU_RES=0.5
# Each uvicorn worker holds its own browser session, so this multiplies memory.
AI_UVICORN_WORKERS=2
AI_OMP_NUM_THREADS=2
AI_MKL_NUM_THREADS=2

FALCON_SZ_INTAI_MEM=2G
FALCON_SZ_INTAI_CPU=1.5
FALCON_SZ_INTAI_MEM_RES=512M
FALCON_SZ_INTAI_CPU_RES=0.25
FALCON_SZ_INTAI_SHM=1gb

# ── Falcon Brain (separate AI host — see docs/FALCON_BRAIN_ARCHITECTURE.md) ───
# Gateway only: an async proxy holding no model weights. GPU serving containers
# are sized in docker-compose.brain.yml against the AI host's budget.
FALCON_SZ_BRAIN_MEM=1G
FALCON_SZ_BRAIN_CPU=1
FALCON_SZ_BRAIN_MEM_RES=128M
FALCON_SZ_BRAIN_CPU_RES=0.25
BRAIN_UVICORN_WORKERS=2

# ── Scraper workers ──────────────────────────────────────────────────────────
# shm_size is RAM-backed tmpfs charged to the container's memory cgroup, and
# Chromium already runs with --disable-dev-shm-usage — keep these small.
FALCON_SZ_NEWS_MEM=6G
FALCON_SZ_NEWS_CPU=4
FALCON_SZ_NEWS_MEM_RES=512M
FALCON_SZ_NEWS_CPU_RES=1
FALCON_SZ_NEWS_SHM=1gb
FALCON_SZ_NEWS_PIDS=800
NEWS_WORKERS=2
NEWS_THREADS=2
SOURCE_WORKERS=2
NEWS_BROWSER_TOTAL_SLOTS=6
NEWS_BROWSER_STUDIO_RESERVED=2
NEWS_BROWSER_AUTO_SLOTS=3
NEWS_BROWSER_MAX_LIVE=6
NEWS_ARTICLE_EXECUTOR_WORKERS=16

FALCON_SZ_FB_MEM=4G
FALCON_SZ_FB_CPU=3
FALCON_SZ_FB_MEM_RES=1G
FALCON_SZ_FB_CPU_RES=1
FALCON_SZ_FB_SHM=1gb
FB_SCRAPE_THREADS=16
FB_METRICS_CONCURRENCY=4

FALCON_SZ_X_MEM=2G
FALCON_SZ_X_CPU=2
FALCON_SZ_X_MEM_RES=512M
FALCON_SZ_X_CPU_RES=0.5
FALCON_SZ_X_SHM=1gb

FALCON_SZ_LI_MEM=1536M
FALCON_SZ_LI_CPU=1.5
FALCON_SZ_LI_MEM_RES=384M
FALCON_SZ_LI_CPU_RES=0.25
FALCON_SZ_LI_SHM=512mb

FALCON_SZ_WEBW_MEM=3G
FALCON_SZ_WEBW_CPU=2
FALCON_SZ_WEBW_MEM_RES=512M
FALCON_SZ_WEBW_CPU_RES=0.5
FALCON_SZ_WEBW_SHM=1gb

FALCON_SZ_IMAGE_MEM=2G
FALCON_SZ_IMAGE_CPU=1.5
FALCON_SZ_IMAGE_MEM_RES=512M
FALCON_SZ_IMAGE_CPU_RES=0.25
FALCON_SZ_IMAGE_SHM=1gb
IMAGE_MAX_CONCURRENT_TABS=4

FALCON_SZ_VIDEO_MEM=2G
FALCON_SZ_VIDEO_CPU=1.5
FALCON_SZ_VIDEO_MEM_RES=512M
FALCON_SZ_VIDEO_CPU_RES=0.25
FALCON_SZ_VIDEO_SHM=1gb
VIDEO_WORKER_CONCURRENCY=2
VIDEO_GUNICORN_THREADS=8

FALCON_SZ_TG_MEM=512M
FALCON_SZ_TG_CPU=1
FALCON_SZ_TG_MEM_RES=128M
FALCON_SZ_TG_CPU_RES=0.25
FALCON_SZ_TG_SHM=256mb

FALCON_SZ_BOTDET_MEM=768M
FALCON_SZ_BOTDET_CPU=1
FALCON_SZ_BOTDET_MEM_RES=256M
FALCON_SZ_BOTDET_CPU_RES=0.25
BOT_DETECTION_WORKERS=2

FALCON_SZ_FLARE_MEM=1024M
FALCON_SZ_FLARE_CPU=1.0
FALCON_SZ_FLARE_MEM_RES=256M
FALCON_SZ_FLARE_CPU_RES=0.25
