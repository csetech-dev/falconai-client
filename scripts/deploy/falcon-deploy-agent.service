[Unit]
Description=FalconAI Deploy Agent (GHCR client)
Documentation=https://github.com/falconai/falconai/blob/main/docs/GHCR_DEPLOY.md
After=docker.service
Requires=docker.service
# Without a start limit, an unrunnable ExecStart (missing file, lost exec bit,
# CRLF shebang -> status=203/EXEC) restarts every 5s forever and never surfaces
# as failed. Five attempts in 5min, then stay in failed state.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/falconai-client
ExecStart=/opt/falconai-client/scripts/deploy-agent.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-deploy-agent
Environment=FALCON_PROJECT_DIR=/opt/falconai-client
# Status files live under PROJECT/.deploy (do not set FALCON_DEPLOY_DIR to project root)
Environment=FALCON_STATUS_DIR=/opt/falconai-client/.deploy
Environment=FALCON_DEPLOY_MODE=ghcr

[Install]
WantedBy=multi-user.target
