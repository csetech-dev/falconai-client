# =============================================================================
# FalconAI — Storage stack environment
# Used by: make deploy-storage
# Copy to .env.storage, edit secrets, then deploy on any host.
# =============================================================================

COMPOSE_PROJECT_NAME=falcon-storage

# -----------------------------------------------------------------------------
# Hardware sizing profile for THIS host: test | prod
# Set independently from the app host — a small storage box beside a large app
# box should stay on 'test'. Sizes the Postgres container and its tuning flags
# (max_connections, shared_buffers, work_mem, …) plus MinIO.
# Vendor-managed defaults live in .env.sizing.<profile>; override single keys
# here, since this file is layered after the profile and wins.
# -----------------------------------------------------------------------------
FALCON_SIZING_PROFILE=test

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=falcon_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass998!
POSTGRES_PORT=12002

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=pass998!
MINIO_API_PORT=12004
MINIO_CONSOLE_PORT=12015

# -----------------------------------------------------------------------------
# WireGuard tunnel (encrypted app<->storage traffic)
# WIREGUARD_ENABLED=true (default): Postgres/MinIO are bound to 127.0.0.1 (NOT
#   public) and reachable from the app host only through the tunnel. The only
#   publicly exposed port is WG_LISTEN_PORT/udp. Requires infra/wireguard/storage/wg0.conf.
# WIREGUARD_ENABLED=false: Postgres/MinIO are published publicly (0.0.0.0) in
#   PLAINTEXT and the app connects directly — no tunnel, no wg0.conf needed.
# See docs/WIREGUARD_STORAGE_TUNNEL.md
# -----------------------------------------------------------------------------
WIREGUARD_ENABLED=true
WG_LISTEN_PORT=51820

# STORAGE_ADVERTISE_IP is no longer used — storage ports are tunnel-only.

# Optional — set when using MinIO console via app gateway (/storage-console/)
# MINIO_BROWSER_REDIRECT_URL=http://APP_HOST:12006/storage-console

# -----------------------------------------------------------------------------
# Docker build
# -----------------------------------------------------------------------------
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
