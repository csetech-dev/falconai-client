# =============================================================================
# FalconAI — Monitoring stack environment (APP host). Scaling plan P1.7b PR 2.
# Copy to /etc/falcon-monitoring/monitoring.env (outside the bundle checkout), then:
#   bash scripts/deploy/deploy-monitoring.sh --check-only
# Runbook: docs/db/scaling/p1-7b-2-monitoring-stack.md
# No secrets in this file: they are files in MONITORING_SECRETS_DIR.
# =============================================================================

# Storage server IP the app server uses today (same as STORAGE_SERVER_IP in .env.app).
# The exporters' TLS certificate is issued for this IP (P1.7b PR 1).
STORAGE_SERVER_IP=
# POSTGRES_EXPORTER_PORT=9187
# NODE_EXPORTER_PORT=9100

# The site's public HTTPS address (what users type), no path. Grafana is served at <this>/grafana/,
# reached through the FalconAI "Monitoring" link (P1.7b PR 3). Example: https://app1.example.com
MONITORING_PUBLIC_URL=

# Secrets (files) and rendered configs. Keep these OUTSIDE /opt/falconai-client.
#   secrets/: metrics_token, storage_exporter_password, storage_ca.crt (owner 65534),
#             grafana_admin_password (owner 472), optional telegram_bot_token (owner 65534)
MONITORING_SECRETS_DIR=/etc/falcon-monitoring/secrets
MONITORING_CONFIG_DIR=/etc/falcon-monitoring/config

# The app stack's Docker network (compose project falcon-app, network falcon-net).
MONITORING_APP_NETWORK=falcon-app_falcon-net

# Prometheus history: 30 days, capped at this size.
PROMETHEUS_RETENTION_SIZE=10GB

# Telegram alerts: OFF unless BOTH this and secrets/telegram_bot_token are set.
TELEGRAM_CHAT_ID=

# Optional overrides
# PROMETHEUS_IMAGE=prom/prometheus:v3.4.1
# ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
# GRAFANA_IMAGE=grafana/grafana:12.0.2
# PROMETHEUS_MEM=1536M
# PROMETHEUS_CPU=1.0
# GRAFANA_MEM=512M
# GRAFANA_CPU=0.5
# ALERTMANAGER_MEM=128M
# ALERTMANAGER_CPU=0.25
