# Rendered by scripts/deploy/monitoring-render.sh into ${MONITORING_CONFIG_DIR}/alertmanager.yml
# (scaling plan P1.7b PR 2). Telegram is used only when the bot token file AND TELEGRAM_CHAT_ID are set;
# otherwise alerts are visible in Alertmanager/Grafana and nothing is sent.
route:
  receiver: '@@RECEIVER_NAME@@'
  group_by: ['alertname', 'job']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: 'null'
@@TELEGRAM_RECEIVER@@
