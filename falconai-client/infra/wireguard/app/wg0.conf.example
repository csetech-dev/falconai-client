# =============================================================================
# WireGuard — APP host tunnel endpoint (10.9.0.2)
# Mount point in falcon-wg-app: /config/wg_confs/wg0.conf
#
# 1. Copy this file to infra/wireguard/app/wg0.conf
# 2. Fill in the keys (generate with: bash scripts/gen-wireguard-keys.sh) and set
#    the storage host's PUBLIC internet IP/hostname in Endpoint below.
# 3. This file is gitignored — it holds the private key. Never commit it.
#
# The PostUp rules DNAT the storage ports published on this container (12002/
# 12004/12015) across the tunnel to the storage peer (10.9.0.1). App services
# reach them via STORAGE_SERVER_IP unchanged.
# =============================================================================

[Interface]
Address = 10.9.0.2/24
ListenPort = 51820
PrivateKey = <APP_PRIVATE_KEY>
# Uncomment if large MinIO/Postgres transfers stall (PMTU blackhole over the tunnel):
# MTU = 1380

PostUp   = iptables -t nat -A PREROUTING  -p tcp --dport 12002 -j DNAT --to-destination 10.9.0.1:12002
PostUp   = iptables -t nat -A PREROUTING  -p tcp --dport 12004 -j DNAT --to-destination 10.9.0.1:12004
PostUp   = iptables -t nat -A PREROUTING  -p tcp --dport 12015 -j DNAT --to-destination 10.9.0.1:12015
PostUp   = iptables -t nat -A POSTROUTING -o wg0 -j MASQUERADE
PostDown = iptables -t nat -D PREROUTING  -p tcp --dport 12002 -j DNAT --to-destination 10.9.0.1:12002
PostDown = iptables -t nat -D PREROUTING  -p tcp --dport 12004 -j DNAT --to-destination 10.9.0.1:12004
PostDown = iptables -t nat -D PREROUTING  -p tcp --dport 12015 -j DNAT --to-destination 10.9.0.1:12015
PostDown = iptables -t nat -D POSTROUTING -o wg0 -j MASQUERADE

[Peer]
# Storage host — set Endpoint to the storage host's PUBLIC IP (or DNS) : WG port
PublicKey = <STORAGE_PUBLIC_KEY>
PresharedKey = <PRESHARED_KEY>
Endpoint = <STORAGE_PUBLIC_IP>:51820
AllowedIPs = 10.9.0.1/32
PersistentKeepalive = 25
